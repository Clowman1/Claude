<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Pre_Approval_Message</name>
        <label>Send Pre-Approval Message</label>
        <locationX>182</locationX>
        <locationY>575</locationY>
        <actionName>TwilioSF__TwilioSendSMS</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Update_Checkbox_Pre_Approval</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>fromNumber</name>
            <value>
                <elementReference>$Label.Twilio_From_Number</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>message</name>
            <value>
                <elementReference>PreApprovalMessage</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>toNumber</name>
            <value>
                <elementReference>$Record.Realtor_Buying_Agent__r.PersonMobilePhone</elementReference>
            </value>
        </inputParameters>
        <nameSegment>TwilioSF__TwilioSendSMS</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <decisions>
        <description>U8 (2026-10): stop on the system&apos;s own recycled-lead writes (the recycle insert, or the reactivation stamp). Everything else proceeds unchanged.</description>
        <name>Recycle_Silent_Check</name>
        <label>Recycle Silent Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Should_Buyer_Be_Sent_Too</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Proceed</defaultConnectorLabel>
        <rules>
            <name>Silent_Recycle_Write</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Recycle_Silent_Write</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Silent recycle write</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Buyer_Be_Sent_Too</name>
        <label>Should Buyer Be Sent Too?</label>
        <locationX>380</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Realtor_Buying_Agent__r.PersonMobilePhone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Realtor_Buying_Agent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Referral_Source__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>What_is_the_Status</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_is_the_Status</name>
        <label>What is the Status?</label>
        <locationX>50</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CommSent_Attempt_1_or_2</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contact Attempt 1</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contact Attempt 2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CommSent_Attempt_2__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Attempt 1 or 2</label>
        </rules>
        <rules>
            <name>Attempt_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contact Attempt 3</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CommSent_Attempt_3__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Attempt 3</label>
        </rules>
        <rules>
            <name>Pre_Approval</name>
            <conditionLogic>2 AND ((1 AND 3) OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pre-Approval</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CommSent_Pre_Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Status_Changed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Letter_Just_Finalized</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Pre_Approval_Message</targetReference>
            </connector>
            <label>Pre-Approval</label>
        </rules>
    </decisions>
    <description>Updated Twilio Message Actions to include the Lead Id as the Parent Id on the Message Record.</description>
    <environments>Default</environments>
    <formulas>
        <name>Attempt1or2Message</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Status}, &apos;Contact Attempt 1&apos;) , &apos;This is our first attempt to reach &apos; + {!$Record.FirstName} + &apos; &apos; + {!$Record.LastName} + &apos; via phone/text. We’ll continue to follow up.&apos;, &apos;This is our second attempt to reach &apos; + {!$Record.FirstName} + &apos; &apos; + {!$Record.LastName} + &apos; via phone/text. We’ll continue to follow up.&apos;) + &quot;  - Reach Home Loans&quot;</expression>
    </formulas>
    <formulas>
        <name>Attempt3or4Message</name>
        <dataType>String</dataType>
        <expression>&apos;We’ve attempted &apos; + {!$Record.FirstName} + &apos; &apos; + {!$Record.LastName} + &apos; 3 times via phone call and text. We’ll move the lead to our nurture queue for the time being. Please let us know if you re-engage the buyer.&apos; + &quot;  - Reach Home Loans&quot;</expression>
    </formulas>
    <formulas>
        <name>ContactedMessage</name>
        <dataType>String</dataType>
        <expression>{!$Record.FirstName} + &quot; &quot; + {!$Record.LastName} + &quot; Update: &quot; + {!$Record.Contacted_Call_Back_Message__c} + &quot;  - Reach Home Loans&quot;</expression>
    </formulas>
    <formulas>
        <name>DocsReceivedMessage</name>
        <dataType>String</dataType>
        <expression>{!$Record.FirstName} + &quot; &quot; + {!$Record.LastName} + &quot; Update: &quot; + {!$Record.Documents_Received_Message__c} + &quot;  - Reach Home Loans&quot;</expression>
    </formulas>
    <formulas>
        <name>DocsRequestedMessage</name>
        <dataType>String</dataType>
        <expression>{!$Record.FirstName} + &quot; &quot; + {!$Record.LastName} + &quot; Update: &quot; + {!$Record.Documents_Requested_Message__c} + &quot;  - Reach Home Loans&quot;</expression>
    </formulas>
    <formulas>
        <description>2026-10-12: the Pre-Approval Letter controller drops Letter_Completed__c and raises it again in one transaction when the agent text is due (a first letter, or a new purchase price), so this is true exactly when a letter needing a text was finalized.</description>
        <name>Letter_Just_Finalized</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!$Record.Letter_Completed__c}), {!$Record.Letter_Completed__c})</expression>
    </formulas>
    <formulas>
        <description>Loan amount as whole dollars with commas.</description>
        <name>LoanAmountText</name>
        <dataType>String</dataType>
        <expression>IF(ROUND({!$Record.Loan_Amount__c},0) &gt;= 1000000, TEXT(FLOOR(ROUND({!$Record.Loan_Amount__c},0)/1000000)) &amp; &quot;,&quot; &amp; LPAD(TEXT(FLOOR(MOD(ROUND({!$Record.Loan_Amount__c},0),1000000)/1000)),3,&quot;0&quot;) &amp; &quot;,&quot; &amp; LPAD(TEXT(MOD(ROUND({!$Record.Loan_Amount__c},0),1000)),3,&quot;0&quot;), IF(ROUND({!$Record.Loan_Amount__c},0) &gt;= 1000, TEXT(FLOOR(ROUND({!$Record.Loan_Amount__c},0)/1000)) &amp; &quot;,&quot; &amp; LPAD(TEXT(MOD(ROUND({!$Record.Loan_Amount__c},0),1000)),3,&quot;0&quot;), TEXT(ROUND({!$Record.Loan_Amount__c},0))))</expression>
    </formulas>
    <formulas>
        <description>2026-10-12: the figures come from the Pre-Approval Letter, which saves them to the Lead and moves it to Pre-Approval on finalize. Without both figures (status moved by hand) only the first sentence is sent.</description>
        <name>PreApprovalMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Great news! &quot; &amp; TRIM(BLANKVALUE({!$Record.FirstName}, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE({!$Record.LastName}, &quot;&quot;)) &amp; &quot; is Pre-Approved.&quot; &amp; IF(OR(ISBLANK({!$Record.Purchase_Price__c}), ISBLANK({!$Record.Loan_Amount__c})), &quot;&quot;, &quot; The Pre-Approval letter for Purchase Price $&quot; &amp; {!PurchasePriceText} &amp; &quot; and Loan Amount $&quot; &amp; {!LoanAmountText} &amp; &quot; is on the way!&quot;) &amp; &quot;  - Reach Home Loans&quot;</expression>
    </formulas>
    <formulas>
        <description>Purchase price as whole dollars with commas (flow formulas have no number format).</description>
        <name>PurchasePriceText</name>
        <dataType>String</dataType>
        <expression>IF(ROUND({!$Record.Purchase_Price__c},0) &gt;= 1000000, TEXT(FLOOR(ROUND({!$Record.Purchase_Price__c},0)/1000000)) &amp; &quot;,&quot; &amp; LPAD(TEXT(FLOOR(MOD(ROUND({!$Record.Purchase_Price__c},0),1000000)/1000)),3,&quot;0&quot;) &amp; &quot;,&quot; &amp; LPAD(TEXT(MOD(ROUND({!$Record.Purchase_Price__c},0),1000)),3,&quot;0&quot;), IF(ROUND({!$Record.Purchase_Price__c},0) &gt;= 1000, TEXT(FLOOR(ROUND({!$Record.Purchase_Price__c},0)/1000)) &amp; &quot;,&quot; &amp; LPAD(TEXT(MOD(ROUND({!$Record.Purchase_Price__c},0),1000)),3,&quot;0&quot;), TEXT(ROUND({!$Record.Purchase_Price__c},0))))</expression>
    </formulas>
    <formulas>
        <description>U8: true on the recycle insert or the reactivation stamp.</description>
        <name>Recycle_Silent_Write</name>
        <dataType>Boolean</dataType>
        <expression>OR(AND(ISNEW(), NOT(ISBLANK({!$Record.Recycled_From_Transaction__c}))), ISCHANGED({!$Record.Recycle_Reactivated_At__c}))</expression>
    </formulas>
    <formulas>
        <name>Status_Changed</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Status})</expression>
    </formulas>
    <formulas>
        <name>WorkingMessage</name>
        <dataType>String</dataType>
        <expression>{!$Record.FirstName} + &quot; &quot; + {!$Record.LastName} + &quot; Update: &quot; + {!$Record.Working_Message__c} + &quot;  - Reach Home Loans&quot;</expression>
    </formulas>
    <interviewLabel>Lead Status Change Message Sends {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Status Change Message Sends</label>
