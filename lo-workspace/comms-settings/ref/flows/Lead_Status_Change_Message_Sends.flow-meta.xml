    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Checkbox_Pre_Approval</name>
        <label>Update Checkbox Pre-Approval</label>
        <locationX>182</locationX>
        <locationY>695</locationY>
        <inputAssignments>
            <field>CommSent_Pre_Approval__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Recycle_Silent_Check</targetReference>
        </connector>
        <filterFormula>AND(
    OR(ISCHANGED({!$Record.Status}), ISCHANGED({!$Record.Letter_Completed__c})),
    NOT(ISBLANK({!$Record.Realtor_Buying_Agent__c})),
    TEXT({!$Record.LeadSource}) = &quot;Realtor Referral&quot;
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
