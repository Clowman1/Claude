<?xml version="1.0" encoding="UTF-8"?>
<RestrictionRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <description>Outside LOs (External_LO permission) see only Document Requests stamped with them. Internal users are not affected.</description>
    <enforcementType>Restrict</enforcementType>
    <masterLabel>External LO - Document Requests</masterLabel>
    <recordFilter>External_LO__c = $User.Id</recordFilter>
    <targetEntity>Lead_Document_Request__c</targetEntity>
    <userCriteria>$Permission.External_LO = true</userCriteria>
    <version>1</version>
</RestrictionRule>
