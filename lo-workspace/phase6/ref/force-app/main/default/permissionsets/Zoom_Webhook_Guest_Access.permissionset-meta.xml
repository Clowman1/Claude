<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>ZoomRecordingWebhook</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Lets the Integrations site guest user log inbound Zoom webhook receipts. Deliberately minimal: a Guest User License cannot read Zoom_Meeting__c records at all, so the webhook only logs and the scheduled sweep does the ingestion as an admin.</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>Custom_Log__c.Data__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Custom_Log__c.Source__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Zoom Webhook Guest Access</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Custom_Log__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
