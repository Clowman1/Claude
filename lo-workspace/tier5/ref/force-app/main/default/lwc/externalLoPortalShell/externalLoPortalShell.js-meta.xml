<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>LO Workspace Shell</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage">
            <property name="defaultView" type="String" label="Opens on" description="perfectDay, leads, loans, realtors... (blank = Perfect Day)"/>
            <property name="startWith" type="String" label="Start with" description="log = open the Log activity form"/>
        </targetConfig>
    </targetConfigs>
    <capabilities>
        <capability>lightningCommunity__RelaxedCSP</capability>
    </capabilities>
</LightningComponentBundle>