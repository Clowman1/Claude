        <fullName>Monthly_Mortgage_Insurance__c</fullName>
        <label>Monthly Mortgage Insurance</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Monthly_Payment_1st__c</fullName>
        <label>Total Monthly Payment</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Monthly_Payment_2nd__c</fullName>
        <label>Monthly Payment (2nd)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Monthly_Payment_and_Interest__c</fullName>
        <formula>Loan_Amount_1st__c  *
( (Rate_1st_TD__c/12)  * ((1 + (Rate_1st_TD__c/12))^Term_1st__c)) /
((1 + (Rate_1st_TD__c/12))^Term_1st__c - 1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>P &amp; I</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Mortgage_Form_Insurance__c</fullName>
        <formula>IF(
    AND(
        BEGINS(TEXT(Loan_Type_1st_TD__c), &quot;Conventional&quot;),
        BEGINS(TEXT(MI_Type__c), &quot;Borrower Paid&quot;)
    ),
    Mortgage_Ins_1st_TD__c,
    NULL
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Mortgage Form Insurance</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Mortgage_Ins_1st_TD__c</fullName>
        <label>Mortgage Ins. (monthly)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
