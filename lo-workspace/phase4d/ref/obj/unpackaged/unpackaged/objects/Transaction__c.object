        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Closed__c</fullName>
        <formula>IF(ISBLANK(Closing_Date__c), FALSE, TRUE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Closed?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Closer_Action_Reason__c</fullName>
        <externalId>false</externalId>
        <formula>IF( TODAY() &gt;=   Two_Days_Before_Closing__c &amp;&amp; ISNULL( Closing_Package_Sent__c ), &quot;Send Closing Package; &quot;, &quot;&quot; ) +
IF(TODAY() =   Closing_Package_Sent__c &amp;&amp; ISPICKVAL(  Closing_Package_Status__c , &apos;&apos;) &amp;&amp; HOUR(TIMENOW() - 4) &gt; 14  ||   TODAY() &gt;  Closing_Package_Sent__c  &amp;&amp; ISPICKVAL(  Closing_Package_Status__c , &quot;&quot;) , &quot;Closing Package Not Dispositioned; &quot;, &quot;&quot; ) +
IF(ISPICKVAL( Closing_Package_Status__c , &quot;Rejected&quot;), &quot;Closing Package Rejected; &quot;, &quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Closer Action Reason</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Closer_Action_Required__c</fullName>
        <formula>AND(
    NOT(ISPICKVAL(Status__c, &apos;Closed&apos;)),
    NOT(ISPICKVAL(Status__c, &apos;Cancelled&apos;)),
    NOT(ISPICKVAL(Status__c, &apos;Post-Closed&apos;)),
    NOT(ISPICKVAL(Status__c, &apos;Lost&apos;)),
OR(
   AND(
       TODAY() &gt;=  Two_Days_Before_Closing__c ,
       ISNULL( Closing_Package_Sent__c )
      ),
   ISPICKVAL(  Closing_Package_Status__c , &quot;Rejected&quot;),
   TODAY() = Closing_Package_Sent__c &amp;&amp; ISPICKVAL(  Closing_Package_Status__c , &quot;&quot;) &amp;&amp; HOUR(TIMENOW() - 4) &gt; 14,
   TODAY() &gt;  Closing_Package_Sent__c  &amp;&amp; ISPICKVAL(  Closing_Package_Status__c , &quot;&quot;)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Closer Action Required</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Closer_Note_Date_Time__c</fullName>
        <label>Closer Note Date/Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Closer_Note__c</fullName>
        <label>Closer Note</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Closing_Date__c</fullName>
        <label>Closing Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Closing_Instructions_Sent__c</fullName>
        <label>Balancing Instructions Sent</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Closing_Month__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(MONTH( Closing_Date__c ),
1,&quot;01-January&quot;, 
2, &quot;02-February&quot;,
3, &quot;03-March&quot;,
4, &quot;04-April&quot;,
5, &quot;05-May&quot;,
6, &quot;06-June&quot;,
7, &quot;07-July&quot;,
