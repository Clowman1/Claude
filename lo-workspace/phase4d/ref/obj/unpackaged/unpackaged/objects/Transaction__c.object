        <externalId>false</externalId>
        <formula>IF(AND(OR(ISPICKVAL(Occupancy__c , &apos;Primary Residence&apos;), ISPICKVAL(Occupancy__c , &apos;Primary&apos;)),  OR(ISPICKVAL(Biz_Dev__c, &apos;Biz Dev - SERHANT ORL&apos;), ISPICKVAL(Biz_Dev__c, &apos;Biz Dev - Reach&apos;), ISPICKVAL(Biz_Dev__c, &apos;Biz Dev - Wemert&apos;))), &apos;Yes&apos;, &apos;No&apos;)</formula>
