        <fullName>Portal_Link_As_URL__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    OR(
        ISBLANK($Setup.BorrowerPortalSettings__c.Borrower_Home_Url__c),
        ISBLANK(Portal_Hash_Parameter__c)
    ),
    &quot;&quot;,
    IF(
        CONTAINS($Setup.BorrowerPortalSettings__c.Borrower_Home_Url__c, &quot;?&quot;),
        $Setup.BorrowerPortalSettings__c.Borrower_Home_Url__c &amp; &quot;&amp;id=&quot; &amp; Portal_Hash_Parameter__c,
        $Setup.BorrowerPortalSettings__c.Borrower_Home_Url__c &amp; &quot;?id=&quot; &amp; Portal_Hash_Parameter__c
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Portal Link As URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
