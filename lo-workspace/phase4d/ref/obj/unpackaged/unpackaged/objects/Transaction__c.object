    <fields>
        <fullName>Days_In_Current_Status__c</fullName>
        <description>Formula count of days since the Transaction entered its current Status.</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Current_Status_Since__c), NULL, TODAY() - Current_Status_Since__c)</formula>
        <label>Days in Current Status</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_In_Warehouse__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Channel__c, &apos;Correspondent&apos;), 
   Funding_Wire_Requested__c - Funded_Date__c, 
   0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days In Warehouse</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_Over_90__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Days_In_Warehouse__c &gt; 90, 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
