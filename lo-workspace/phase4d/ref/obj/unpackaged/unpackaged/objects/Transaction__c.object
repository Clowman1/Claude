    <searchLayouts>
        <customTabListAdditionalFields>Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Closing_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Occupancy__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Property_Address__c</customTabListAdditionalFields>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <sharingReasons>
        <fullName>Loan_Officer__c</fullName>
        <label>Loan Officer</label>
    </sharingReasons>
    <validationRules>
        <fullName>Cancelled</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Status__c , &apos;Cancelled&apos;),
    OR(
        ISPICKVAL(Withdrawn_Reason__c , &quot;&quot;),
        ISBLANK(Withdrawn__c)
    )
)</errorConditionFormula>
        <errorMessage>You must fill in a Withdrawn Reason to move this Loan to Cancelled. Please use the &quot;Cancel Loan&quot; action.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cant_Mark_Note_Rcvd_without_PC_satisfied</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISNULL(PC_Conditions_Satisfied__c ),
    NOT(ISNULL(    Purchase_Advice_Date__c  )) 
  )</errorConditionFormula>
        <errorMessage>Can not mark Purchase Advice Date until PC Conditions are satisfied</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Fedex_Label_Sent_Requires_Tracking_Numbe</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(ISBLANK(FedEx_Label_Sent__c)) &amp;&amp; ISBLANK(FedexTrackingNumber__c)</errorConditionFormula>
        <errorDisplayField>FedexTrackingNumber__c</errorDisplayField>
        <errorMessage>Please enter the fedex tracking number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Funding_Date_Must_Be_Filled_In</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
   ISBLANK(Funding_Date__c),
   ISPICKVAL(Status__c, &apos;Post-Closed&apos;)
)</errorConditionFormula>
        <errorMessage>Please fill in the Funding Date before moving this Transaction to Post-Closed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Funding_without_Closing_Package_Accepted</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED( Status__c ),
    ISPICKVAL(Status__c , &apos;Funding&apos;),
    NOT(ISPICKVAL( Closing_Package_Status__c, &apos;Accepted&apos; ))
)</errorConditionFormula>
        <errorMessage>Closing Package must be accepted to Move File to Funding</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Lender_is_required</fullName>
        <active>true</active>
        <description>This rule makes the Lender field required when the transaction reaches Processing status.</description>
        <errorConditionFormula>AND( ISBLANK( Lender_lookup__c ) , ISPICKVAL( Status__c , &quot;Processing&quot;)  )</errorConditionFormula>
        <errorMessage>The Lender field cannot be blank. Please enter a value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Loan_Cmmtmnt_date_required</fullName>
        <active>true</active>
        <description>The Loan Commitment Date cannot be blank if the status is Submitted or Processing</description>
        <errorConditionFormula>AND( ISBLANK( Loan_Commitment_Date__c ),  ISPICKVAL(  Loan_Purpose__c  , &quot;Purchase&quot;) , OR( ISPICKVAL( Status__c , &quot;Submitted&quot;),  ISPICKVAL(Status__c, &quot;Processing&quot;)  ) )</errorConditionFormula>
        <errorMessage>The Loan Commitment Date cannot be blank.  Please enter the date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Loan_Partner_Reassignment_Restricted</fullName>
        <active>true</active>
        <description>Only the current Loan Partner, or a user with the Loan Partner Reassignment custom permission, may change Loan_Partner__c. Values matching the Loan Officer mapping are allowed so the Stamp Loan Partner flow can stamp it.</description>
        <errorConditionFormula>AND(
    ISCHANGED(Loan_Partner__c),
    PRIORVALUE(Loan_Partner__c) &lt;&gt; $User.Id,
    Loan_Partner__c &lt;&gt; Loan_Officer__r.Loan_Partner__c,
    NOT($Permission.Loan_Partner_Reassignment)
)</errorConditionFormula>
        <errorDisplayField>Loan_Partner__c</errorDisplayField>
        <errorMessage>Only an Admin or the currently assigned Loan Partner can change the Loan Partner on this Transaction. Please contact an Admin if this file needs a different Loan Partner.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MERS_Min_is_null</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Closing&quot;),
    ISBLANK(MERS_Min__c)
)</errorConditionFormula>
        <errorMessage>MERS Min is required before moving to Closing status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Need_Title_Closer_Email_for_Fed_Ref_Num</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(Federal_Reference_Number__c ),
    NOT(ISBLANK(Federal_Reference_Number__c)),
    ISBLANK(  Title_Closer_Email__c )
)</errorConditionFormula>
        <errorMessage>Please Provide Title Closer Email</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Owner_Change_on_transactions</fullName>
        <active>true</active>
        <description>Blocks Loan Officer Profile users from changing Transaction ownership, unless they hold the Transaction Owner Reassignment custom permission (openers carrying an LO profile).</description>
        <errorConditionFormula>ISCHANGED( OwnerId ) &amp;&amp;  $User.ProfileId  = &quot;00ef2000001wwBC&quot;  &amp;&amp;  $User.Id  &lt;&gt; &quot;005f2000009NwSs&quot;  &amp;&amp;  NOT($Permission.Transaction_Owner_Reassignment)</errorConditionFormula>
        <errorMessage>You do not have permission to change record ownership for this record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pre_Processing_LP_1st_Required_Fields</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
DATEVALUE(CreatedDate) &gt;= DATE(2024, 12, 20),
ISCHANGED(Status__c),
NOT(ISPICKVAL(Status__c, &apos;TRID Application&apos;)),
NOT(ISPICKVAL(Status__c, &apos;Open&apos;)),
NOT(ISPICKVAL(Status__c, &apos;Disclosures Out&apos;)),
NOT(ISPICKVAL(Status__c, &apos;Conditionally Approved&apos;)),
ISPICKVAL(Lien_Position__c, &apos;1st&apos;),
OR(
ISBLANK(TEXT(Loan_Type_1st_TD__c)),
ISBLANK(Loan_1st_TD__c),
ISBLANK(TEXT(Doc_Type_1st_TD__c)),
ISBLANK(Loan_Amount_1st__c),
ISBLANK(TEXT(MCC__c)),
ISBLANK(TEXT(Loan_Program_1st__c)),
ISBLANK(Term_1st__c),
ISBLANK(Rate_1st_TD__c),
ISBLANK(PITI__c),
ISBLANK(TEXT(MI_Type__c)),
ISBLANK(DTI_Front_End__c),
ISBLANK(DTI_Back_End__c ),
ISBLANK(LTV__c),
ISBLANK(FICO__c),
AND (
ISBLANK(Mortgage_Ins_1st_TD__c),
CONTAINS(TEXT(MI_Type__c), &apos;Borrower Paid&apos;)
)
)
)</errorConditionFormula>
        <errorMessage>Please, fill out required fields section</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pre_Processing_LP_2nd_Required_Fields</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
DATEVALUE(CreatedDate) &gt;= DATE(2024, 12, 20),
ISCHANGED(Status__c),
NOT(ISPICKVAL(Status__c, &apos;TRID Application&apos;)),
NOT(ISPICKVAL(Status__c, &apos;Open&apos;)),
NOT(ISPICKVAL(Status__c, &apos;Disclosures Out&apos;)),
NOT(ISPICKVAL(Status__c, &apos;Conditionally Approved&apos;)),
ISPICKVAL(Lien_Position__c, &apos;2nd&apos;),
OR(
ISBLANK(TEXT(Loan_Type_2nd_TD__c)),
ISBLANK(Loan_2nd_TD__c),
ISBLANK(TEXT(Doc_Type_2nd_TD__c)),
ISBLANK(Loan_Amount_2nd__c),
ISBLANK(Term_2nd__c)
)
)</errorConditionFormula>
        <errorMessage>Please, fill out required fields section</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Preapproval_Type_Mutual_Exclusion</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Zoom_Preapproval__c, In_Person_Preapproval__c)</errorConditionFormula>
        <errorMessage>Only one preapproval type can be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Moving_From_PC_Review_Unless_Com</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
   Skip_Post_Closed_Validation__c = FALSE,
   ISCHANGED(Status__c),
   ISPICKVAL(Status__c, &quot;Post-Closed&quot;),
      OR(
         AND(ISBLANK(Update_Data_From_UWM__c), Lender_lookup__c = &quot;0015x00002GLWu9AAH&quot;),
         AND(ISBLANK(Update_all_Loan_Data_from_Investor_LOS__c), Transaction_is_UWM_File__c = &quot;No&quot;),
         AND(ISBLANK(Add_Client_to_Home_Bot__c), Show_HomeBot_Checklist__c = &quot;Yes&quot;),
         AND(ISBLANK(Send_Client_Review_Request_Call_Text__c)),
         AND(ISBLANK(Move_OneDrive_File_into_Closed_Loans__c))
      )
)</errorConditionFormula>
        <errorMessage>Please complete Post-Closing checklist before moving to Post-Closed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Processing_Required_Fields</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
DATEVALUE(CreatedDate) &gt;= DATE(2024, 12, 20),
ISCHANGED(Status__c),
ISPICKVAL(Status__c, &apos;Processing&apos;),
NOT(ISPICKVAL(Status__c, &apos;Conditionally Approved&apos;)),
PRIORVALUE(Status__c) = &apos;Pre-Processing&apos;,
OR(
ISBLANK(TEXT(Occupancy__c)),
ISBLANK(TEXT(Property_Type__c)),
ISBLANK(Purchase_Price__c),
ISBLANK(Down_Payment__c),
ISBLANK(Property_Address__c ),
ISBLANK(Property_State__c),
ISBLANK(Property_City__c),
ISBLANK(Property_Postal_Code__c),
ISBLANK(Year_Property_Acquired__c),
ISBLANK(County__c)
)
)</errorConditionFormula>
        <errorMessage>Please, fill out Processing required fields section</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Rate_Lock_ISNULL_In_Submitted_Status</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Status__c,&apos;Submission Form Complete&apos;),
    ISPICKVAL(Rate_Lock_Status__c, &apos;Locked&apos;),
    ISNULL(Rate_Lock_Exp_Date__c)
)</errorConditionFormula>
        <errorMessage>Rate Lock Expiration is required before moving to Submission</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Review_Explanation_When_No</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  ISPICKVAL(ReviewCallCompleted__c, &quot;No&quot;),
  ISBLANK(Review_Explanation__c)
)</errorConditionFormula>
        <errorDisplayField>Review_Explanation__c</errorDisplayField>
        <errorMessage>Review Explanation is required when Review Call Completed is No.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Submission_Form_Must_Be_Completed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &apos;Open&apos;),
    ISBLANK(Submission_Form_Date__c),
    NOT(
        AND(
            ISPICKVAL(Lien_Position__c, &apos;2nd&apos;),
            NOT(ISBLANK(First_Mortgage__c))
        )
    )
)</errorConditionFormula>
        <errorMessage>You must complete the Submission Form before moving to Open.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>SendWithDocuSign</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Send with Docusign</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>{!URLFOR($Site.BaseUrl + &apos;/apex/dfsle__sending&apos;, null, [sId = Transaction__c.Id])}</url>
    </webLinks>
    <webLinks>
        <fullName>Send_Bulk</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Send Bulk SMS</masterLabel>
        <openType>noSidebar</openType>
        <page>Send_Bulk_SMS_Transaction</page>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
    </webLinks>
    <webLinks>
        <fullName>Send_SMS</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Send SMS</masterLabel>
        <openType>noSidebar</openType>
        <page>TransactionSingleSMS</page>
        <protected>false</protected>
    </webLinks>
    <webLinks>
        <fullName>Send_Text</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Text</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/14.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/14.0/apex.js&quot;)}  
{!REQUIRESCRIPT(&apos;/resource/smagicinteract__smJQuery/js/jquery-1.10.2.js&apos;)} 
{!REQUIRESCRIPT(&apos;/resource/smagicinteract__smJQuery/js/jquery-ui-1.10.4.custom.min.js&apos;)} 
{!REQUIRESCRIPT(&quot;/resource/smagicinteract__sendSMSJS&quot;)}

var cssUrl = &apos;{!URLFOR(&apos;/resource/smagicinteract__smJQuery/css/sm-theme/jquery-ui-1.10.4.custom.min.css&apos;)}&apos;; 

var packagePrefix = &quot;smagicinteract__&quot;;
var userId = &apos;{!$User.Id}&apos;;  
var elementIdVar = &apos;&apos;;
var showUserDropDown = false; 
var dialogTitle = &apos;&apos;; 
var recordType = &apos;Transaction__c&apos;;  // Enter the API name of an object
var idToUpdate = &apos;{!Transaction__c.Id}&apos; // Enter merge field of id for example:- for Contact object enter &apos;{!Transaction__c.Id}&apos;
var nameField = &apos;Name&apos;; // Enter the API Name of a Name Field
var mobileField = &apos;Borrowers_Phone__c&apos;;  // Enter the API Name of a Mobile Field. For multiple mobile fields, add API Names of Mobile Fields comma separated (Max 3 allowed)
var optOutField = &apos;smagicinteract__SMSOptOut__c&apos;; // Enter API name of optOut field 
var optOutDefaultValue = &apos;no&apos;;     // Enter the default OptOut Value
var smsType = &apos;&apos;; // Enter type as &apos;popup&apos; if you want to send message from popup
var unrelatedObjectAPIName = &apos;&apos;; // Enter the API Name of an Unrelated object

sendSMS(recordType, idToUpdate, userId, nameField, mobileField, optOutField, optOutDefaultValue, smsType, elementIdVar, packagePrefix, showUserDropDown, dialogTitle, cssUrl, unrelatedObjectAPIName);</url>
    </webLinks>
</CustomObject>
