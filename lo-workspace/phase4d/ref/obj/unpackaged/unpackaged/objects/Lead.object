            <field>LEAD.RECORDTYPE</field>
            <operation>notEqual</operation>
            <value>Lead.Realtor_Lead_record_type,Lead.Loan_Officer_Lead_Record_Type</value>
        </filters>
        <filters>
            <field>LEAD.STATUS</field>
            <operation>notEqual</operation>
            <value>Nurture - Preapproval,Nurturing,Pre-Approval,Submitted For Disclosures</value>
        </filters>
        <filters>
            <field>LEAD.STATUS</field>
            <operation>notContain</operation>
            <value>Pre-Approval</value>
        </filters>
        <label>Leads All</label>
        <sharedTo>
            <role>Loan_Officer</role>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>My_Leads_New_to_Contact</fullName>
        <columns>FULL_NAME</columns>
        <columns>LEAD.STATUS</columns>
        <columns>LEAD.CREATED_DATE</columns>
        <columns>LEAD.PHONE</columns>
        <columns>LEAD.EMAIL</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>LEAD.STATUS</field>
            <operation>equals</operation>
            <value>New</value>
        </filters>
        <filters>
            <field>LEAD.CONVERTED</field>
            <operation>equals</operation>
            <value>0</value>
        </filters>
        <label>My Leads - New to Contact</label>
    </listViews>
    <listViews>
        <fullName>My_Nurtured_Leads</fullName>
        <columns>FULL_NAME</columns>
        <columns>LEAD.STATUS</columns>
        <columns>LEAD.PHONE</columns>
        <columns>LEAD.EMAIL</columns>
        <columns>Loan_Purpose__c</columns>
        <columns>LEAD.LAST_ACTIVITY</columns>
        <columns>Appointment_Date_Time__c</columns>
        <columns>LEAD.CREATED_DATE</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>LEAD.CONVERTED</field>
            <operation>equals</operation>
            <value>0</value>
        </filters>
        <filters>
            <field>LEAD.STATUS</field>
            <operation>equals</operation>
            <value>Nurturing,Nurture - Preapproval</value>
        </filters>
        <label>My Nurtured Leads</label>
    </listViews>
    <listViews>
