    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Buyers_Agent_Required_for_Purchases</fullName>
        <active>false</active>
        <description>This rule requires the Buyer&apos;s Agent field to be populated when the Loan Purpose is Purchase.</description>
        <errorConditionFormula>ISBLANK( Realtor_Buying_Agent__c ) &amp;&amp;  INCLUDES( Loan_Purpose__c , &quot;Purchase&quot;)</errorConditionFormula>
        <errorMessage>Buying Agent is required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Calls_Required_for_Status_Change</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				ISCHANGED(Status),
				NOT(ISCHANGED(Number_of_Calls__c)),
				$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
				NOT(ISCHANGED(LO_Takeover_At__c)),
				OR(
        CONTAINS(Record_Type__c, &apos;Consumer Purchase&apos;),
								CONTAINS(Record_Type__c, &apos;Consumer Refinance&apos;)
				)
)</errorConditionFormula>
        <errorMessage>Please Log an Activity to Update the Lead’s Status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Can_not_convert_without_Channel</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISCHANGED(IsConverted),
IsConverted = True,
ISBLANK(TRID_Date__c),
RecordTypeId != &apos;0125x000000KuZGAA0&apos;
)</errorConditionFormula>
        <errorMessage>TRID Date has not populated from Arive. Please toggle the loan status to Qualification in Arive.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Contacted_Call_Back_must_have_Appt_Date</fullName>
        <active>false</active>
        <description>This rule requires a lead in Contacted/Call Back status to also have an appointment date and time.</description>
        <errorConditionFormula>AND( ISPICKVAL( Status , &quot;Contacted/Call Back&quot;) , ISNULL(  Appointment_Date_Time__c  ) )</errorConditionFormula>
        <errorMessage>The Appointment Date Time field cannot be blank.  Please enter the appointment date and time in this field, and a calendar event will be created for you.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Docs_Received_Message</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL(  LeadSource , &apos;Realtor Referral&apos; ),
    ISPICKVAL( Status , &apos;Documents Received for Review&apos; ),
    ISCHANGED( Status ),
    INCLUDES( Loan_Purpose__c , &apos;Purchase&apos; ),
    ISBLANK( Documents_Received_Message__c  ),
    Buying_Agent_has_Changed__c = FALSE
)</errorConditionFormula>
        <errorDisplayField>Documents_Received_Message__c</errorDisplayField>
        <errorMessage>Please fill in Documents Received Message</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Docs_Requested_Message</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL( LeadSource , &apos;Realtor Referral&apos; ),
    ISPICKVAL( Status , &apos;Documents Requested&apos; ),
    ISCHANGED( Status ),
    INCLUDES( Loan_Purpose__c , &apos;Purchase&apos; ),
    ISBLANK( Documents_Requested_Message__c ),
    Buying_Agent_has_Changed__c = FALSE
)</errorConditionFormula>
        <errorDisplayField>Documents_Requested_Message__c</errorDisplayField>
        <errorMessage>Please fill in Documents Requested Message</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Lawrence_Lanos_Rule</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(OwnerId),
    OwnerId == &quot;005Qi000000q6MH&quot;,
    $User.Id == &quot;005Qi000000q6MH&quot;,
    OR(
        ISBLANK(Referred_By_Realtor_Group__c),
        Referred_By_Realtor_Group__c &lt;&gt; &quot;The Nickley Group&quot;
    ),
    OR(
        ISBLANK(TEXT(LeadSource)),
        NOT(ISPICKVAL(LeadSource, &quot;Nickley ISA&quot;))
    ),
    OR(
        ISBLANK(TEXT(Referral_Source__r.Account.Realtor_Group__c)),
        NOT(ISPICKVAL(Referral_Source__r.Account.Realtor_Group__c, &quot;The Nickley Group&quot;))
    ),
    OR(
        ISBLANK(TEXT(Realtor_Buying_Agent__r.Realtor_Group__c)), 
        NOT(ISPICKVAL(Realtor_Buying_Agent__r.Realtor_Group__c, &quot;The Nickley Group&quot;))
    ),
    OR(
        ISBLANK(TEXT(Referral_Source__r.Account.Realtor_Group__c)),
        NOT(ISPICKVAL(Referral_Source__r.Account.Realtor_Group__c, &quot;Nickley ISA&apos;s&quot;))
    ),
    OR(
        ISBLANK(TEXT(Realtor_Buying_Agent__r.Realtor_Group__c)), 
        NOT(ISPICKVAL(Realtor_Buying_Agent__r.Realtor_Group__c, &quot;Nickley ISA&apos;s&quot;))
    ),
    OR(
        ISBLANK(ReferralFormSourceEmail__c),
        NOT(CONTAINS(ReferralFormSourceEmail__c, &quot;nickleygroup&quot;))
    )
)</errorConditionFormula>
        <errorMessage>Lawrence Lanos is only able to claim leads from The Nickley Group and from Nickley ISA lead source</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Lead_Rating_and_Loan_Amount_Fields_requr</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Status, &apos;Pre-Approval&apos;),
    ISBLANK(Loan_Amount__c)
)</errorConditionFormula>
        <errorMessage>The Loan Amount field must be filled in before applying for pre-approval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Lead_Source_Change_Restricted</fullName>
        <active>true</active>
        <description>Locks Lead Source once set. Only the Owner, the Loan Partner, a Lead Source Change holder, or the LO Workspace Nurturing takeover (stamps LO_Takeover_At__c in the same save) may change it.</description>
        <errorConditionFormula>AND(
    ISCHANGED(LeadSource),
    NOT(ISBLANK(TEXT(PRIORVALUE(LeadSource)))),
    $User.Id &lt;&gt; OwnerId,
    $User.Id &lt;&gt; Loan_Partner__c,
    NOT($Permission.Lead_Source_Change),
    NOT(ISCHANGED(LO_Takeover_At__c))
)</errorConditionFormula>
        <errorDisplayField>LeadSource</errorDisplayField>
        <errorMessage>Lead Source is locked once it has been set. Only the Lead Owner, the assigned Loan Partner, or an Admin can change it. Please contact an Admin if this Lead Source is wrong.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Lead_already_claimed</fullName>
        <active>true</active>
        <description>This rule will prohibit a user from changing a record owner when the lead record is already claimed (owner is not Adam) and the Lead Source is &quot;Facebook - Landing Refi&quot;.</description>
        <errorConditionFormula>AND( ISCHANGED( OwnerId ) , NOT($Permission.Lead_Owner_Reassignment), PRIORVALUE( OwnerId ) &lt;&gt; &quot;005f2000009Buua&quot; , ISPICKVAL( LeadSource , &quot;Facebook - Landing Refi&quot;),  $User.UserRoleId &lt;&gt;&quot;00E5x000002OGkS&quot;, NOT(ISCHANGED(LO_Takeover_At__c)))</errorConditionFormula>
        <errorMessage>This record has already been claimed. You cannot change the record owner.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Loan_Officers_Cannot_Change_Owner</fullName>
        <active>true</active>
        <description>Prevents Loan Officer profiles from changing Lead ownership.</description>
        <errorConditionFormula>ISCHANGED(OwnerId) &amp;&amp;
CONTAINS($Profile.Name, &quot;Loan Officer&quot;) &amp;&amp;
NOT($Permission.Lead_Owner_Reassignment) &amp;&amp;
NOT(ISCHANGED(LO_Takeover_At__c))</errorConditionFormula>
        <errorMessage>Loan Officers cannot change the owner of a Lead. Please contact an Admin if this Lead needs to be reassigned.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Loan_Partner_Reassignment_Restricted</fullName>
        <active>true</active>
        <description>Only the current Loan Partner, or a user with the Loan Partner Reassignment custom permission, may change Loan_Partner__c. Values matching the owner mapping are allowed so the Assign Loan Partner on Lead flow can stamp it.</description>
        <errorConditionFormula>AND(
    ISCHANGED(Loan_Partner__c),
    PRIORVALUE(Loan_Partner__c) &lt;&gt; $User.Id,
    Loan_Partner__c &lt;&gt; Owner:User.Loan_Partner__c,
    NOT($Permission.Loan_Partner_Reassignment)
)</errorConditionFormula>
        <errorDisplayField>Loan_Partner__c</errorDisplayField>
        <errorMessage>Only an Admin or the currently assigned Loan Partner can change the Loan Partner on this Lead. Please contact an Admin if this Lead needs a different Loan Partner.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Loan_Purpose_Is_Required</fullName>
        <active>false</active>
        <description>This rule requires the Loan Purpose to be populated if the Lead Source is either Realtor Referral, Past Client, Personal Referral, Previous Client Referral, or Biz Dev Outlaw.</description>
        <errorConditionFormula>AND(
ISBLANK( Loan_Purpose__c ),
NOT(ISPICKVAL(Status , &apos;New&apos;)),
OR( ISPICKVAL( LeadSource , &quot;Realtor Referral&quot;), 
ISPICKVAL( LeadSource , &quot;Past Client&quot;), 
ISPICKVAL( LeadSource , &quot;Personal Referral&quot;), 
ISPICKVAL( LeadSource , &quot;Previous Client Referral&quot;), 
ISPICKVAL( LeadSource , &quot;Reach In Market Dialer&quot;),  
ISPICKVAL( LeadSource , &quot;Biz Dev - Outlaw&quot;), 
ISPICKVAL( LeadSource , &quot;Biz Dev - Saludes&quot;), 
ISPICKVAL( LeadSource , &quot;Biz Dev - Carey&quot;)))</errorConditionFormula>
        <errorMessage>Loan Purpose is required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Megan_Cannot_Reassign_Loan_Partner</fullName>
        <active>false</active>
        <description>DEACTIVATED 2026-09-10 - superseded by Loan_Partner_Reassignment_Restricted, which applies the same restriction to every non-Admin, non-Loan-Partner user on both Lead and Transaction.</description>
        <errorConditionFormula>AND(
    ISCHANGED(Loan_Partner__c),
    NOT(ISCHANGED(OwnerId)),
    $User.Id = &quot;0055x00000BWkSBAA1&quot;,
    PRIORVALUE(Loan_Partner__c) &lt;&gt; $User.Id
)</errorConditionFormula>
        <errorDisplayField>Loan_Partner__c</errorDisplayField>
        <errorMessage>You can only change the Loan Partner on Leads where you are the assigned Loan Partner. Please contact an Admin if this Lead needs a different Loan Partner.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Message_for_Contacted_Call_Back</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL( LeadSource , &apos;Realtor Referral&apos; ),
    ISPICKVAL( Status , &apos;Contacted/Call Back&apos;),
    ISCHANGED( Status ),
    INCLUDES(  Loan_Purpose__c , &apos;Purchase&apos;),
    ISBLANK(  Contacted_Call_Back_Message__c ),
    Buying_Agent_has_Changed__c = FALSE
)</errorConditionFormula>
        <errorDisplayField>Contacted_Call_Back_Message__c</errorDisplayField>
        <errorMessage>Must fill in Contacted/Call Back Message!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Owner_Change_on_Leads</fullName>
        <active>true</active>
        <description>This rule will return an error if a user with the profile of Loan Officer tries to change record ownership on a lead that does not have a status of New and a Lead Source of Facebook - Landing Refi.</description>
        <errorConditionFormula>ISCHANGED( OwnerId ) &amp;&amp;  $User.ProfileId  = &quot;00ef2000001wwBC&quot;  &amp;&amp;  $User.Id  &lt;&gt; &quot;005f2000009NwSs&quot;  &amp;&amp;  NOT($Permission.Lead_Owner_Reassignment) &amp;&amp;  NOT(ISPICKVAL(Status, &quot;New&quot;) )&amp;&amp;  NOT(ISPICKVAL (LeadSource, &quot;Facebook - Landing Refi&quot;))</errorConditionFormula>
        <errorMessage>You do not have permission to change record ownership for this record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Preapproval_Type_Mutual_Exclusion</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Zoom_Preapproval__c, In_Person_Preapproval__c)</errorConditionFormula>
        <errorMessage>Only one preapproval type can be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Select_Channel_Before_Converting</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
     IsConverted = true,
     ISPICKVAL(Channel__c, &quot;&quot;)
)</errorConditionFormula>
        <errorMessage>Please Select Channel before converting</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Submission_Form_must_be_completed</fullName>
        <active>false</active>
        <description>In order for a lead to be converted, the Submission Form must be completed.</description>
        <errorConditionFormula>AND( 
ISCHANGED(IsConverted),
IsConverted = True,
Submission_Form_Completed__c = False)</errorConditionFormula>
        <errorDisplayField>ActiveCamp__Active_Campaign_Id__c</errorDisplayField>
        <errorMessage>Please complete the Submission Form before converting this lead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Working_Message_Missing</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL( LeadSource , &apos;Realtor Referral&apos; ),
    ISPICKVAL( Status , &apos;Working&apos;),
    ISCHANGED( Status ),
    INCLUDES(  Loan_Purpose__c , &apos;Purchase&apos;),
    ISBLANK(   Working_Message__c  ),
    Buying_Agent_has_Changed__c = FALSE
)</errorConditionFormula>
        <errorDisplayField>Working_Message__c</errorDisplayField>
        <errorMessage>Please fill in Working Message</errorMessage>
    </validationRules>
