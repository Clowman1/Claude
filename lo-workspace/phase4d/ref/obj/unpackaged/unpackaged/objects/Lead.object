        <label>Lead Owner Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Lead_Owner_Phone__c</fullName>
        <externalId>false</externalId>
        <formula>Owner:User.MobilePhone</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Lead Owner Phone #</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Lead_Portal_Link_As_URL__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    OR(
        ISBLANK($Setup.BorrowerPortalSettings__c.Lead_Borrower_Home_Url__c),
        ISBLANK(Portal_Hash_Parameter__c)
    ),
    &quot;&quot;,
    SUBSTITUTE(
        IF(
            RIGHT($Setup.BorrowerPortalSettings__c.Lead_Borrower_Home_Url__c, 1) = &quot;/&quot;,
            LEFT(
                $Setup.BorrowerPortalSettings__c.Lead_Borrower_Home_Url__c,
                LEN($Setup.BorrowerPortalSettings__c.Lead_Borrower_Home_Url__c) - 1
            ),
            $Setup.BorrowerPortalSettings__c.Lead_Borrower_Home_Url__c
        ),
        &quot;/s&quot;,
        &quot;/apex/LeadBorrowerDocumentPortal&quot;
    ) &amp; &quot;?id=&quot; &amp; Portal_Hash_Parameter__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Lead Portal Link As URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
