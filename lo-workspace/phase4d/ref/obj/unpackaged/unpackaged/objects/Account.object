    <validationRules>
        <fullName>Email_required_Realtor</fullName>
        <active>false</active>
        <errorConditionFormula>AND(  
    INCLUDES(Group__pc ,&apos;Realtor&apos;),
    ISBLANK( PersonEmail )
 )</errorConditionFormula>
        <errorMessage>Email required on Realtor Group Accounts.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Owner_Change_on_Accounts</fullName>
        <active>true</active>
        <description>This rule will return an error is a user with the profile of Loan Officer tries to change record ownership on an account.</description>
        <errorConditionFormula>ISCHANGED( OwnerId ) &amp;&amp;  $User.ProfileId  = &quot;00ef2000001wwBC&quot;  &amp;&amp;  $User.Id  &lt;&gt; &quot;005f2000009NwSs&quot;</errorConditionFormula>
        <errorMessage>You do not have permission to change record ownership for this record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RealtorGroup_PhoneNum</fullName>
        <active>false</active>
        <errorConditionFormula>AND(  INCLUDES(Group__pc  , &apos;Realtor&apos;) , ISBLANK(Phone) )</errorConditionFormula>
        <errorMessage>Phone number required on Realtor Group Accounts.</errorMessage>
    </validationRules>
