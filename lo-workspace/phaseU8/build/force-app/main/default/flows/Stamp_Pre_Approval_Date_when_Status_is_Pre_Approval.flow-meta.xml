<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <decisions>
        <description>U8 (2026-10): stop on the system's own recycled-lead writes (the recycle insert, or the reactivation stamp). Everything else proceeds unchanged.</description>
        <name>Recycle_Silent_Check</name>
        <label>Recycle Silent Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Lead_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Proceed</defaultConnectorLabel>
        <rules>
            <name>Silent_Recycle_Write</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Recycle_Silent_Write</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Silent recycle write</label>
        </rules>
    </decisions>
    <description>This flow will stamp the Current Date when the Lead Status is changed to &quot;Pre-Approval&quot;</description>
    <environments>Default</environments>
    <formulas>
        <description>U8: true on the recycle insert or the reactivation stamp.</description>
        <name>Recycle_Silent_Write</name>
        <dataType>Boolean</dataType>
        <expression>OR(AND(ISNEW(), NOT(ISBLANK({!$Record.Recycled_From_Transaction__c}))), ISCHANGED({!$Record.Recycle_Reactivated_At__c}))</expression>
    </formulas>
    <interviewLabel>Stamp Pre-Approval Date when Status is Pre-Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stamp Pre-Approval Date when Status is Pre-Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Lead_Status</name>
        <label>Update Lead Status</label>
        <locationX>1096</locationX>
        <locationY>385</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Pre_Approval_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>970</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Recycle_Silent_Check</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pre-Approval</stringValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
