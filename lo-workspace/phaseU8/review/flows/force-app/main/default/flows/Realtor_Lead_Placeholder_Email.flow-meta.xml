<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Placeholder_Email</name>
        <label>Set Placeholder Email</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Email</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>na@na.com</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <description>Realtor Submission Form leads may arrive with no borrower email, but the ARIVE file created alongside the Lead requires one. Stamps na@na.com on create so the ARIVE file is still created. Only fires on insert, so a real email entered later is never overwritten.</description>
    <environments>Default</environments>
    <interviewLabel>Realtor Lead Placeholder Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Realtor Lead Placeholder Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Placeholder_Email</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ReferralFormSourceEmail__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
