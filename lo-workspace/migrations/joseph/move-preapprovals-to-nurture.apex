// Moves Joseph's 87 aged Pre-Approval leads to Nurture - Preapproval (ids in preapproval-leads-before.json, 2026-10-15). Undo: set Status back to Pre-Approval.
List<Lead> ls = [SELECT Id FROM Lead WHERE Id IN ('00QQi000001zdv8MAA','00QQi000003QufxMAC','00QQi0000044bLGMAY','00QQi000004eX7rMAE','00QQi000005YVcoMAG','00QQi000005glu6MAA','00QQi000005nYldMAE','00QQi000005yPgsMAE','00QQi0000066lDjMAI','00QQi0000068rQHMAY','00QQi000006VCO1MAO','00QQi000006ogVFMAY','00QQi000006xcLxMAI','00QQi000006y1NZMAY','00QQi0000072fZJMAY','00QQi000007CagRMAS','00QQi000007Wd3pMAC','00QQi0000089SQIMA2','00QQi000008CiIPMA0','00QQi000008TtxQMAS','00QQi000009lsfhMAA','00QQi000009qBlNMAU','00QQi00000AEH01MAH','00QQi00000AHSTZMA5','00QQi00000AHl9dMAD','00QQi00000AJG05MAH','00QQi00000AJI3VMAX','00QQi00000ALaApMAL','00QQi00000ATBojMAH','00QQi00000AVgejMAD','00QQi00000AlDFNMA3','00QQi00000ApxDCMAZ','00QQi00000BBSlpMAH','00QQi00000BGcfjMAD','00QQi00000BIbdtMAD','00QQi00000Baq4zMAB','00QQi00000BiBkcMAF','00QQi00000Bkcn9MAB','00QQi00000CFnMTMA1','00QQi00000CFzluMAD','00QQi00000CfkRNMAZ','00QQi00000Cxgh3MAB','00QQi00000DDeY4MAL','00QQi00000Dq5QtMAJ','00QQi00000EDGZyMAP','00QQi00000ESfg5MAD','00QQi00000F3SvCMAV','00QQi00000FK2rTMAT','00QQi00000FXOuAMAX','00QQi00000FXPv4MAH','00QQi00000Fs3mhMAB','00QQi00000G7sFOMAZ','00QQi00000HJCN3MAP','00QQi00000IE6KwMAL','00QQi00000ITuinMAD','00QQi00000IYj3aMAD','00QQi00000IfnnBMAR','00QQi00000IjRrLMAV','00QQi00000Iwu97MAB','00QQi00000J24r0MAB','00QQi00000JGzXdMAL','00QQi00000JJpQTMA1','00QQi00000JJvkPMAT','00QQi00000JL8sUMAT','00QQi00000JOeRBMA1','00QQi00000JtVpqMAF','00QQi00000K4e1nMAB','00QQi00000KHj24MAD','00QQi00000KZTGaMAP','00QQi00000KyRbKMAV','00QQi00000KzQIEMA3','00QQi00000LEVhOMAX','00QQi00000LLLBrMAP','00QQi00000LLx5pMAD','00QQi00000LOBvuMAH','00QQi00000LOlwAMAT','00QQi00000LUhppMAD','00QQi00000LxYj7MAF','00QQi00000M0qTPMAZ','00QQi00000MFE62MAH','00QQi00000MGiWfMAL','00QQi00000MYU8fMAH','00QQi00000NZtSdMAL','00QQi00000NZptfMAD','00QQi00000Nsqh9MAB','00QQi00000NtBf7MAF','00QQi00000QyUXMMA3') AND Status = 'Pre-Approval'];
for (Lead l : ls) l.Status = 'Nurture - Preapproval';
List<Database.SaveResult> res = Database.update(ls, false);
Integer ok = 0;
for (Integer i = 0; i < res.size(); i++) { if (res[i].isSuccess()) ok++; else System.debug('FAIL ' + ls[i].Id + ' ' + res[i].getErrors()[0].getMessage()); }
System.debug('MOVED ' + ok + ' of ' + ls.size());
