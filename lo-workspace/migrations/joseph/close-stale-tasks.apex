// Closes Joseph's 81 overdue auto-created 'Submit Files' tasks (ids from before-overdue-tasks.json, 2026-10-15). Cure Incomplete File tasks left open.
List<Task> ts = [SELECT Id FROM Task WHERE Id IN ('00TQi000001nltFMAQ','00TQi000002D9JGMA0','00TQi000002UTy1MAG','00TQi000005y6r8MAA','00TQi00000621MRMAY','00TQi000006oySaMAI','00TQi000006yMjsMAE','00TQi0000076PRMMA2','00TQi000008O6G2MAK','00TQi000008XNcjMAG','00TQi000009Z1AVMA0','00TQi00000BMpokMAD','00TQi00000DOZWqMAP','00TQi00000DPsMMMA1','00TQi00000Da2eyMAB','00TQi00000DsI8cMAF','00TQi00000E1kIxMAJ','00TQi00000EfOCpMAN','00TQi00000FmpW3MAJ','00TQi00000G6n8PMAR','00TQi00000GI5GMMA1','00TQi00000GUPETMA5','00TQi00000GeimIMAR','00TQi00000GfcRaMAJ','00TQi00000Gpb7cMAB','00TQi00000HO2tLMAT','00TQi00000HwbjnMAB','00TQi00000I5ibAMAR','00TQi00000ITSumMAH','00TQi00000ItbuaMAB','00TQi00000IutKmMAJ','00TQi00000JXhstMAD','00TQi00000KaECJMA3','00TQi00000L0Rc3MAF','00TQi00000LAjavMAD','00TQi00000M7uKMMAZ','00TQi00000NJdV9MAL','00TQi00000NocLGMAZ','00TQi00000PT9HjMAL','00TQi00000QZklnMAD','00TQi00000QuU7xMAF','00TQi00000RUN9kMAH','00TQi00000TjJPDMA3','00TQi00000TsXuSMAV','00TQi00000VNQrMMAX','00TQi00000VOTARMA5','00TQi00000Vmw6JMAR','00TQi00000W3EpCMAV','00TQi00000X3h1AMAR','00TQi00000X9byWMAR','00TQi00000Y3VaJMAV','00TQi00000YaJjvMAF','00TQi00000Z8Fx5MAF','00TQi00000a8JX1MAM','00TQi00000aAEudMAG','00TQi00000b3hGDMAY','00TQi00000bZc5AMAS','00TQi00000bZcoIMAS','00TQi00000d042FMAQ','00TQi00000d2ZL1MAM','00TQi00000d2aydMAA','00TQi00000dNSBqMAO','00TQi00000dReCpMAK','00TQi00000dmAZsMAM','00TQi00000dmUCvMAM','00TQi00000dmeZsMAI','00TQi00000dmpmyMAA','00TQi00000e5qGiMAI','00TQi00000ejiaoMAA','00TQi00000ek8egMAA','00TQi00000ekLfKMAU','00TQi00000ekNpFMAU','00TQi00000f09VFMAY','00TQi00000fEjB7MAK','00TQi00000fFl5ZMAS','00TQi00000fM2BeMAK','00TQi00000fMJFxMAO','00TQi00000hzaiuMAA','00TQi00000iaCr6MAE','00TQi00000j3JAhMAM','00TQi00000ohcYQMAY') AND IsClosed = false];
for (Task t : ts) t.Status = 'Completed';
List<Database.SaveResult> res = Database.update(ts, false);
Integer ok = 0;
for (Integer i = 0; i < res.size(); i++) { if (res[i].isSuccess()) ok++; else System.debug('FAIL ' + ts[i].Id + ' ' + res[i].getErrors()[0].getMessage()); }
System.debug('CLOSED ' + ok + ' of ' + ts.size());
