// Clears Megan as Loan Partner on Manny's 90 open leads (ids from before-lead-lps.json, 2026-10-14).
Set<Id> ids = new Set<Id>{ '00QQi00000emjyHMAQ','00QQi00000eqUcTMAU','00QQi00000eqSdvMAE','00QQi00000eqyXKMAY','00QQi00000evNk1MAE','00QQi00000evOt1MAE','00QQi00000ewayZMAQ','00QQi00000f3eyzMAA','00QQi00000f451VMAQ','00QQi00000f45kfMAA','00QQi00000f7KtdMAE','00QQi00000f9DxhMAE','00QQi00000fBwYxMAK','00QQi00000fCmR5MAK','00QQi00000fFyfPMAS','00QQi00000fGu1qMAC','00QQi00000fKMCsMAO','00QQi00000fLMNkMAO','00QQi00000fLnuAMAS','00QQi00000fMLkYMAW','00QQi00000fN27zMAC','00QQi00000fQJNaMAO','00QQi00000fQJvSMAW','00QQi00000fT8c7MAC','00QQi00000fUFN1MAO','00QQi00000fUWUHMA4','00QQi00000ff0sTMAQ','00QQi00000fg31uMAA','00QQi00000T78ZdMAJ','00QQi00000frCLDMA2','00QQi00000frQUcMAM','00QQi00000ftHa5MAE','00QQi00000ftEdqMAE','00QQi00000ftRw4MAE','00QQi00000ftTQ0MAM','00QQi00000fvLMhMAM','00QQi00000fvSPlMAM','00QQi00000fveIuMAI','00QQi00000fvZhPMAU','00QQi00000fyQ85MAE','00QQi00000fySZjMAM','00QQi00000g3QtqMAE','00QQi00000g72MfMAI','00QQi00000gBWArMAO','00QQi00000gC4pGMAS','00QQi00000gCFpWMAW','00QQi00000gFUFLMA4','00QQi00000gGtJiMAK','00QQi00000gLWHdMAO','00QQi00000gMyF3MAK','00QQi00000gNp3FMAS','00QQi00000gNbMsMAK','00QQi00000gTEvRMAW','00QQi00000gTTODMA4','00QQi00000gTwGXMA0','00QQi00000gUTVpMAO','00QQi00000gYZXpMAO','00QQi00000gYfgTMAS','00QQi00000gbEJxMAM','00QQi00000gfs5uMAA','00QQi00000gnoOTMAY','00QQi00000golq8MAA','00QQi00000gq4YoMAI','00QQi00000gvzL8MAI','00QQi00000gwEIXMA2','00QQi00000gzE1CMAU','00QQi00000h8Fu0MAE','00QQi00000hDW2yMAG','00QQi00000hMWN9MAO','00QQi00000LO6BSMA1','00QQi00000hzakBMAQ','00QQi00000hzb0IMAQ','00QQi00000i1xmNMAQ','00QQi00000i5oaoMAA','00QQi00000iAwHZMA0','00QQi00000iByfSMAS','00QQi00000ij8T9MAI','00QQi00000in24CMAQ','00QQi00000ioXVhMAM','00QQi00000iyzYoMAI','00QQi00000jOyYzMAK','00QQi00000jOoZgMAK','00QQi00000jYb1dMAC','00QQi00000jxVnRMAU','00QQi00000kDSOzMAO','00QQi00000kdn6RMAQ','00QQi00000kmKjWMAU','00QQi00000l2mBzMAI','00QQi00000l8BXtMAM','00QQi00000lQanxMAC' };
List<Lead> leads = [SELECT Id FROM Lead WHERE Id IN :ids AND OwnerId = '005Qi00000TYQgvIAH' AND Loan_Partner__c != null];
for (Lead l : leads) l.Loan_Partner__c = null;
List<Database.SaveResult> res = Database.update(leads, false);
Integer ok = 0;
for (Integer i = 0; i < res.size(); i++) {
    if (res[i].isSuccess()) ok++; else System.debug('FAIL ' + leads[i].Id + ' ' + res[i].getErrors()[0].getMessage());
}
System.debug('CLEARED ' + ok + ' of ' + leads.size());
