    <rules>
        <fullName>Purchase Lead Submitted Biz Dev</fullName>
        <actions>
            <name>Email_when_lead_is_under_contract_Biz_Dev</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Lead.LeadSource</field>
            <operation>contains</operation>
            <value>Biz Dev</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.Loan_Purpose__c</field>
            <operation>equals</operation>
            <value>Purchase</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.Submission_Form_Completed__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Purchase Lead Submitted Biz Dev Realtor Ref</fullName>
        <actions>
            <name>Email_when_lead_is_under_contract_Realtor_Referral</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <booleanFilter>1 AND 2 AND (3 OR 4)</booleanFilter>
        <criteriaItems>
            <field>Lead.Loan_Purpose__c</field>
            <operation>equals</operation>
            <value>Purchase</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.Submission_Form_Completed__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.LeadSource</field>
            <operation>contains</operation>
            <value>Biz Dev</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.LeadSource</field>
            <operation>equals</operation>
            <value>Realtor Referral</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
