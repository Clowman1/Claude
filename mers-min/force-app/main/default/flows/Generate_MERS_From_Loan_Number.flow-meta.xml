<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Generate_MERS</name>
        <label>Generate MERS</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>MersUtility</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Update_MERS_Min_on_Transaction</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>numberRepresentation</name>
            <value>
                <elementReference>MERSInput</elementReference>
            </value>
        </inputParameters>
        <nameSegment>MersUtility</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>MERSNumber</assignToReference>
            <name>output</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow will call the Generate MERS Utility to calculate the MERS Min. It will then stamp that newly generated Number onto the Transaction in the MERS_Min Field. Loan number is left-padded to 10 digits so the MIN is always 18 (7 org ID + 10 + check digit). Gold Star and NMSI issue their own MINs and are excluded. Fires once Loan Number, Correspondent channel and Lender are all set, in any order (MIN blank), and again whenever the loan number changes.</description>
    <environments>Default</environments>
    <formulas>
        <name>MERSInput</name>
        <dataType>String</dataType>
        <expression>&quot;1016472&quot; + LPAD({!$Record.Loan_Number__c}, 10, &quot;0&quot;)</expression>
    </formulas>
    <interviewLabel>Generate MERS From Loan Number {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Generate MERS From Loan Number</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_MERS_Min_on_Transaction</name>
        <label>Update MERS Min on Transaction</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>MERS_Min__c</field>
            <value>
                <elementReference>MERSNumber</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Generate_MERS</targetReference>
        </connector>
        <filterFormula>AND(
    NOT(ISBLANK({!$Record.Loan_Number__c})),
    ISPICKVAL({!$Record.Channel__c}, &quot;Correspondent&quot;),
    NOT(ISBLANK({!$Record.Lender_lookup__c})),
    {!$Record.Lender_lookup__c} &lt;&gt; &quot;0015x00002GLWuAAAX&quot;,
    {!$Record.Lender_lookup__c} &lt;&gt; &quot;001Qi00001aarVGIAY&quot;,
    OR(ISCHANGED({!$Record.Loan_Number__c}), ISBLANK({!$Record.MERS_Min__c}))
)</filterFormula>
        <object>Transaction__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>MERSNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
