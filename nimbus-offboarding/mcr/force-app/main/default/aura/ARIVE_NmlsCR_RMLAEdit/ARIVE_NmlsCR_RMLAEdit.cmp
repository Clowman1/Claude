 - Created by Zeyad Jabra on 8/17/2019.
 -->

<aura:component controller="ARIVE_NmlsCallReportController" description="ARIVE_NmlsCR_RMLAEdit">
    <aura:attribute type="Object" name="report"/>
    <aura:attribute type="Boolean" name="isOpen" default="false"/>
    <aura:attribute type="Boolean" name="isLocked" default="true"/>
    <aura:attribute type="Boolean" name="spinner"/>
    <aura:attribute type="Boolean" name="showResetConfirmation" default="false"/>
    <aura:attribute type="String" name="baseUrl" default="https://callreportgenerator.herokuapp.com/api/report"/>
    <aura:attribute type="Boolean" name="isGeneratingXml" default="false"/>
    <aura:attribute type="Integer" name="step" access="global"/>
    <aura:attribute type="Object" name="reportDetailTable"/>
    <aura:attribute type="Map" name="currentState"/>
    <c:AriveLoadingScreen content="Generating XML Report..."
                          isShown="{!v.isGeneratingXml}"/>
    <!--                          imgSrc="{!$Resource.nmlscr_images + '/nmlscr_Images/builders.svg'}" imgWidth="400px;"-->
    
    <aura:html tag="style">
        .slds-modal__container{
        width: 70vw;
        max-width: 70vw;
        min-width: 70vw;
        }
        .slds-modal__content{
        height: auto !important;
        max-height: unset !important;
        }
    </aura:html>
    <div class="slds-is-relative">
        <aura:if isTrue="{!v.spinner}">
            <lightning:spinner size="large"/>
        </aura:if>
        <lightning:card title="Review Reports by State" variant="base">
            <aura:set attribute="actions">
                <div style="{!v.showResetConfirmation ? 'display:none;' : ''}">
                    <lightning:button class="arive-reset-report" variant="destructive" label="Restart Report"
                                      onclick="{!c.restartReport}"/>
                    <lightning:button class="arive-reset-report" variant="brand"
                                      label="Generate Residential Mortgages Data"
                                      onclick="{!c.generateResidentialFirstMortgagesReportData}"/>
                    <lightning:button variant="brand" label="Generate XML" class="arive-generate-xml-button"
                                      onclick="{!c.generateXml}"/>
                </div>
            </aura:set>

            <aura:if isTrue="{! v.showResetConfirmation == false}">
                <div class="slds-grid arive-state-selector slds-wrap slds-m-around--medium slds-grid_vertical-align-center ">
                    <aura:iteration items="{!v.report.stateOptions}" var="state">
                        <div data-state="{!state.stateCode}"
                             class="{!state.isComplete ?  'slds-item slds-size-2-of-12 slds-text-link-faux arive-state-complete' : 'slds-item slds-size-2-of-12 slds-text-link-faux '}"
                             style="height:100px;" onclick="{!c.selectState}">
                            {!state.stateCode}
                        </div>
                    </aura:iteration>
                </div>
                <aura:set attribute="else">
                    <div class="slds-grid slds-wrap slds-align-content-center">
                        <div class="slds-p-around--small"><i>Any current progress will be lost. Would you like to
                                restart the report?</i></div>
                        <div class="slds-p-around--medium">
                            <lightning:button variant="brand" label="Go Back To Report"
                                              onclick="{!c.cancelRestart}"/>
                            <lightning:button class="arive-reset-report" variant="destructive"
                                              label="Yes, Restart Report"
                                              onclick="{!c.confirmRestart}"/>
                        </div>
                    </div>
                </aura:set>
            </aura:if>
        </lightning:card>
    </div>
    <aura:if isTrue="{! and(v.currentState != null, v.isOpen)}">
        <c:Modal hasHeader="true"
                 canClose="false"
                 size="large"
                 isModalOpen="{!v.isOpen}" hasFooter="true">
            <aura:set attribute="headerIcon">
                <!--                <div style="text-align:center;">-->
                <!--                    <img style="width:auto; height:50px;"-->
                <!--                         src="{!$Resource.nmlscr_stateIcons + '/Active/' +v.currentState.stateCode +'.svg'}"/>-->
                <!--                </div>-->

            </aura:set>
            <aura:set attribute="footer">
                <div class="slds-grid slds-grid--align-spread slds-text-align--center slds-grid_vertical-align-center arive-modal-footer">
                    <aura:if isTrue="{!v.reportDetailTable != null}">
                        <div class="arive-modal-footer-actions">
                            <lightning:button label="Exit Review"
                                              onclick="{!c.closeStateReview}"/>
                        </div>
                        <div class="slds-grid slds-gutters_x-small arive-modal-footer-actions">
                            <lightning:button variant="brand" label="Close Datapoint Details"
                                              onclick="{!c.clearReportDetailTable}"/>
                        </div>
                        <aura:set attribute="else">
                            <div class="slds-grid">
                                <div class="slds-grid slds-grid_vertical-align-center slds-p-around--small">
                                    <div style="width:15px; height:15px;" class="arive-background-yellow"></div>&nbsp; User
                                    Input Required
                                </div>
                            </div>
                            <div class="slds-grid slds-gutters_x-small arive-modal-footer-actions">
                                <lightning:button label="Exit Review"
                                                  onclick="{!c.closeStateReview}"/>
                                <lightning:button class="arive-text-white" variant="success" label="Mark State Complete"
                                                  onclick="{!c.markStateComplete}"/>
                            </div>
                        </aura:set>
                    </aura:if>
                </div>
            </aura:set>
            <aura:set attribute="body">
                <aura:if isTrue="{!v.reportDetailTable != null}">
                    <div class="slds-grid arive-report-table slds-p-around--medium arive-detial-table-page">
                        <div class="sld-item slds-size--12-of-12">
                            <div class="slds-grid slds-text-align--center">
                                <div class="slds-size--12-of-12 slds-text-heading--medium slds-m-around--medium">{!v.reportDetailTable.title}</div>
                            </div>
                            <aura:if isTrue="{!!(v.reportDetailTable.rows.length > 0)}">
                                <div class="slds-grid slds-wrap slds-align-content-center slds-text-align--center slds-p-around--xx-large">
                                    <!--                                    <div class="slds-item slds-size&#45;&#45;12-of-12">-->
                                    <!--                                        <img src="{!$Resource.nmlscr_images + '/nmlscr_Images/noReports.svg'}"-->
                                    <!--                                             style="width:250px; height:auto;"/>-->
                                    <!--                                    </div>-->
                                    <div class="slds-item slds-size--12-of-12 slds-p-around--large slds-text-title_bold">
                                        <p>No Loans found for this datapoint.</p>
                                    </div>
                                </div>
                            </aura:if>
                            <aura:iteration items="{!v.reportDetailTable.rows}" var="row" indexVar="rowNumber">
                                <div class="slds-grid"
                                     style="white-space: nowrap; padding: 10px 0; justify-content:space-between; ">
                                    <aura:if isTrue="{!rowNumber == 0}">
                                        <aura:iteration items="{!row.fields}" var="field">
                                            <div class="slds-item slds-size--2-of-12">
                                                <b>{!field.label}</b>
                                            </div>
                                        </aura:iteration>
                                    </aura:if>
                                </div>
                                <a style="cursor:pointer;" onclick="{!c.navigateToLoan}" data-id="{!row.id}" target="_blank">
                                    <div class="slds-grid slds-grid_align-space arive-table-row">
                                        <aura:iteration items="{!row.fields}" var="field">
                                            <aura:if isTrue="{!field.label == 'Loan Amount'}">
                                                <div class="slds-item slds-size--2-of-12">
                                                    <lightning:formattedNumber value="{!field.value}" style="currency" currencyCode="USD"/>
                                                </div>
                                                <aura:set attribute="else">
                                                    <div class="slds-item slds-size--2-of-12">
                                                        {!field.value}
                                                    </div>
                                                </aura:set>
                                            </aura:if>
                                        </aura:iteration>
                                    </div>
                                </a>
                            </aura:iteration>
                        </div>
                    </div>
                    <aura:set attribute="else">
                        <lightning:tabset>
                            <lightning:tab label="Application Data">
                                <div class="arive-report-section slds-p-around--x-small">
                                    <div class="slds-grid">
                                        <div class="slds-item slds-size--6-of-12">
                                            <div class="slds-text-heading--medium slds-p-around--small">Application
                                                Data
                                            </div>
                                        </div>
                                        <div class="slds-item  slds-size--6-of-12 slds-text-align--center">
                                            <div class="slds-text-heading--small">Directly Received From Borrower</div>
                                        </div>
                                    </div>
                                    <div class="arive-nmlscr-state-subheader slds-grid slds-p-around--small slds-border--bottom"
                                         style="position: sticky;top: -12px;background: white;">
                                        <div class="slds-item slds-size--6-of-12 slds-text-align--center
                                             arive-cell-lock slds-grid slds-p-around--medium
                                             slds-grid_vertical-align-center">
                                            <lightning:icon class="slds-p-horizontal--medium"
                                                            iconName="{!if(v.isLocked, 'utility:lock', 'utility:unlock')}"
                                                            size="medium"/>
                                            <span style="cursor:pointer;" onclick="{!c.toggleLock}"
                                                  class="slds-text-link">{!if(v.isLocked, 'Unlock', 'Lock')}
                                                Cells</span>
                                        </div>
                                        <div class="slds-item slds-grid   slds-size--6-of-12 slds-text-align--center">
                                            <div style="width:100%;"
                                                 class="slds-grid slds-grid_vertical-align-center slds-grid_align-space slds-text-title_bold">
                                                <div class="slds-item slds-size--4-of-12">Amount<br/>($)</div>
                                                <div class="slds-item slds-size--4-of-12">Count<br/>(#)</div>
                                                <div class="slds-item slds-size--4-of-12">Average<br/>($)</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="slds-grid slds-p-around--small">
                                        <div class="slds-item slds-size--6-of-12">
                                            <div class="slds-text-heading--small"><i>Application Pipeline</i></div>
                                        </div>

                                    </div>

                                    <div class="arive-report-subsection slds-p-horizontal--small">
                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC010" onclick="{!c.getReportDetailTable}">AC010
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">Applications in
                                                Process at
                                                the
                                                Beginning
                                                of the Period
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency aura:id="applicationData.AC010.AC066"
                                                                  blur="{!c.calculateAverage}" disabled="{!v.isLocked}"
                                                                  value="{!v.currentState.applicationData.AC010_1}"/>

                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber aura:id="applicationData.AC010.AC066"
                                                                blur="{!c.calculateAverage}" disabled="{!v.isLocked}"
                                                                value="{!v.currentState.applicationData.AC010_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC010_3}"/>
                                            </div>
                                        </div>
                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC020" onclick="{!c.getReportDetailTable}">AC020
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">Applications
                                                Received
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC020.AC066"
                                                                  value="{!v.currentState.applicationData.AC020_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                aura:id="applicationData.AC020.AC066"
                                                                value="{!v.currentState.applicationData.AC020_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC020_3}"/>
                                            </div>
                                        </div>
                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC030" onclick="{!c.getReportDetailTable}">AC030
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">Applications
                                                Approved but
                                                not
                                                Accepted
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC030.AC066"
                                                                  value="{!v.currentState.applicationData.AC030_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                aura:id="applicationData.AC030.AC066"
                                                                value="{!v.currentState.applicationData.AC030_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC030_3}"/>
                                            </div>
                                        </div>

                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC040" onclick="{!c.getReportDetailTable}">AC040
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">
                                                Applications Denied
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC040.AC066"
                                                                  value="{!v.currentState.applicationData.AC040_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                aura:id="applicationData.AC040.AC066"
                                                                value="{!v.currentState.applicationData.AC040_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC040_3}"/>
                                            </div>
                                        </div>

                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC050" onclick="{!c.getReportDetailTable}">AC050
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">
                                                Applications Withdrawn
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC050.AC066"
                                                                  value="{!v.currentState.applicationData.AC050_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                aura:id="applicationData.AC050.AC066"
                                                                value="{!v.currentState.applicationData.AC050_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC050_3}"/>
                                            </div>
                                        </div>

                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC060" onclick="{!c.getReportDetailTable}">AC060
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">
                                                File Closed for Incompleteness
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC060.AC066"
                                                                  value="{!v.currentState.applicationData.AC060_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                aura:id="applicationData.AC060.AC066"
                                                                value="{!v.currentState.applicationData.AC060_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC060_3}"/>
                                            </div>
                                        </div>

                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC062" onclick="{!c.getReportDetailTable}">AC062
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">
                                                Pre-Approval Requests Denied
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC062.AC066"
                                                                  value="{!v.currentState.applicationData.AC062_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                aura:id="applicationData.AC062.AC066"
                                                                value="{!v.currentState.applicationData.AC062_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC062_3}"/>
                                            </div>
                                        </div>
                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC064" onclick="{!c.getReportDetailTable}">AC064
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">
                                                Pre-Approval Requests Approved but not Accepted
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC064.AC066"
                                                                  value="{!v.currentState.applicationData.AC064_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                aura:id="applicationData.AC064.AC066"
                                                                value="{!v.currentState.applicationData.AC064_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC064_3}"/>
                                            </div>
                                        </div>
                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code slds-size--1-of-12">AC065</div>
                                            <div class="arive-report-label-name slds-size--5-of-12">
                                                Net Changes in Application Amount (decreases should be reflected as
                                                negative)
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency class="arive-background-yellow" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC065.AC066"
                                                                  value="{!v.currentState.applicationData.AC065_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                            </div>
                                        </div>

                                        <div class="arive-report-row arive-subtotal-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code slds-size--1-of-12">AC066</div>
                                            <div class="arive-report-label-name slds-size--5-of-12">
                                                Total Application Pipeline
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC066_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="true"
                                                                value="{!v.currentState.applicationData.AC066_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC066_3}"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="slds-grid slds-p-around--small">
                                        <div class="slds-item slds-size--6-of-12">
                                            <div class="slds-text-heading--small"><i>Application Pipeline Results</i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="arive-report-subsection slds-p-horizontal--small">
                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
                                                 data-datapoint="AC070" onclick="{!c.getReportDetailTable}">AC070
                                            </div>
                                            <div class="arive-report-label-name slds-size--5-of-12">
                                                Loans Closed and Funded
                                            </div>
                                            <div class="arive-report-cell  slds-size--2-of-12">
                                                <ui:inputCurrency disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                  aura:id="applicationData.AC070.AC090"
                                                                  value="{!v.currentState.applicationData.AC070_1}"/>
                                            </div>
                                            <div class="arive-report-cell slds-size--2-of-12">
                                                <ui:inputNumber disabled="{!v.isLocked}" blur="{!c.calculateAverage}"
                                                                aura:id="applicationData.AC070.AC090"
                                                                value="{!v.currentState.applicationData.AC070_2}"/>
                                            </div>
                                            <div class="arive-report-cell arive-cell-average slds-size--2-of-12-">
                                                <ui:inputCurrency disabled="true"
                                                                  value="{!v.currentState.applicationData.AC070_3}"/>
                                            </div>
                                        </div>
                                        <div class="arive-report-row slds-grid slds-text-body--small">
                                            <div class="arive-report-label-code arive-clickable slds-size--1-of-12"
