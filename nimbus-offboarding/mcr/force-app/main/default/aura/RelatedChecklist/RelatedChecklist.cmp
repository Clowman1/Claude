<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId" access="global" controller="ChecklistController">
    <aura:attribute name="checklist" type="Object" access="global" default="{ 'items' : [] }"/>
    <aura:attribute name="checkListCount" type="String" access="global" />
    <aura:attribute name="isLoading" type="Object" access="global" default="true"/>
    <aura:attribute name="fields" type="String" access="global"/>
    <aura:handler event="force:refreshView" action="{! c.init}" />
    <aura:attribute name="configuration" type="String" access="global"/>
   
</aura:component>