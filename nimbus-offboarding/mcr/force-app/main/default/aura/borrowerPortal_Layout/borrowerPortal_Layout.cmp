<aura:component description="borrowerPortal_Layout"
    extends="forceCommunity:navigationMenuBase"
    implements="forceCommunity:themeLayout"
    access="global"
>
    <aura:attribute type="Aura.Component[]" name="mainContent"/>
    <aura:attribute type="Aura.Component[]" name="contactBar"/>
    <aura:attribute type="String" name="primaryGradientColor" access="global"/>
    <aura:attribute type="String" name="secondaryGradientColor"  access="global"/>
    <aura:attribute type="String" name="mobileHeaderText" default="Secure Document Portal"  access="global"/>
    <aura:attribute type="Boolean" name="isLoaded"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:if  isTrue="{!v.isLoaded}">
        <div class="imbus-mobile-header">
            <div class="imbus-menu-logo-mobile">  </div>
        </div>
        <div class="imbus-container">
            <div class="imbus-sidebar">
                <div class="imbus-menu-logo">  </div>
            </div>
            <div class="imbus-main-content">
                {!v.mainContent}
            </div>
            <div class="imbus-contact-bar">
                {!v.contactBar}
            </div>
        </div>
    </aura:if>
</aura:component>