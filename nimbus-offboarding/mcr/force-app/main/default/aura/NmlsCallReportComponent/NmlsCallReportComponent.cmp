<aura:component controller="ARIVE_NmlsCallReportController"
                implements="flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes"
                description="NmlsCallReportComponent">
    <aura:attribute name="report" type="Map" default="{ startDate : null, endDate : null, states : []}"/>
    <aura:attribute name="step" type="Integer" default="0"/>
    <aura:attribute name="isLoading" type="Boolean" default="false"/>
    <aura:attribute name="pastFiles" type="Object"/>


    <aura:attribute name="helpVideoId" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <lightning:layout
            verticalAlign="center"
            class="slds-m-bottom_large">
        <!--            class="{!add('slds-p-left-large slds-p-bottom-large slds-border-bottom ', step==0 ? '' : 'arive-hide-report-header')}"-->

        <lightning:layoutItem>
            <img class="arive-nmlscr-header-img"
                 src="data:image/png;base64," style="margin-left: 26px;margin-right: 40px;"></img>
        </lightning:layoutItem>
        <lightning:layoutItem>
            <div class="slds-text-heading_large">Generate Call Report inside Reach</div>
            <div class="slds-p-top_x-small slds-p-bottom_x-small" style="font-size: 0.8125rem; max-width: 700px;"><span>Welcome to Reach's NMLS Mortgage Call Report reporting tool. Here owners and company administrators will be able to generate application, closed loan, and individual mortgage loan originator information on a state by state basis. After confirming the information is as expected, simply download the XML and upload to the NMLS website.<br/><br/> </span><span>You can review loan details used in each calculation, self report and override values, navigate to loan files, manage your progress, and more. Enjoy the MCR tool as we take the pain out of regulatory reporting.</span>
            </div>
            <!--            <a href="{! '/s/arive-training?id=' + v.helpVideoId}" class=" slds-text-link">Watch Help Video</a>-->
        </lightning:layoutItem>

    </lightning:layout>
    <lightning:layout class="slds-m-top-large">
        <lightning:layoutItem size="8" padding="horizontal-medium">
            <aura:if isTrue="{!v.step==0}">
                <c:ARIVE_NmlsCR_GenerateReportCard report="{!v.report}" step="{!v.step}"/>
                <aura:set attribute="else">
                    <c:ARIVE_NmlsCR_RMLAEdit step="{!v.step}" report="{!v.report}"/>
                </aura:set>
            </aura:if>
        </lightning:layoutItem>
        <lightning:layoutItem size="4" padding="horizontal-large">
        </lightning:layoutItem>
    </lightning:layout>
</aura:component>