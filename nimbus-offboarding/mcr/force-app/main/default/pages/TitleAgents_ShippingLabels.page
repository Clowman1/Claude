<apex:page controller="TitleAgents_ShippingLabelsController" action="{!sendMessage}">
    <apex:stylesheet value="{!$Resource.titleconfirmation}"/>
    <style>
        .ncs-hidden {
            display:none;
        }
    </style>
    <html style="font-size: 16px;">
      <body class="u-body u-xl-mode"> 
        <section class="skrollable u-clearfix u-image u-parallax u-shading u-section-1" id="sec-615a" data-image-width="1600" data-image-height="1067" style="background-image: linear-gradient(0deg, rgba(0,27,84,0.75), rgba(0,27,84,0.75)), url({!URLFOR($Resource.titleBackground)});"> 
          <div class="u-clearfix u-sheet u-sheet-1">
            <div class="u-clearfix u-expanded-width u-gutter-0 u-layout-wrap u-layout-wrap-1">
              <div class="u-layout">
                <div class="u-layout-col">
                  <div class="u-size-30">
                    <div class="u-layout-row">
                      <div class="u-container-style u-layout-cell u-left-cell u-size-30 u-layout-cell-1">
                        <div class="u-container-layout u-container-layout-1">
                          <img class="u-image u-image-default u-preserve-proportions u-image-1" src="{!$Resource.reachInverseLogo}" alt="" data-image-width="220" data-image-height="81"/>
                        </div>
                      </div>
                      <div class="u-align-right u-container-style u-layout-cell u-right-cell u-size-30 u-layout-cell-2">
                        <div class="u-container-layout u-container-layout-2">
                          <h4 class="u-text u-text-1">{!fileName}</h4>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="u-size-30">
                    <div class="u-layout-row">
                      <div class="u-container-style u-layout-cell u-left-cell u-right-cell u-size-60 u-layout-cell-3">
                        <div class="u-container-layout u-container-layout-3">
                            
                            <div style=" padding:40px;" class="u-align-center u-form-group u-form-submit">
                        <h2 class=" {!IF(isConfirmed,'ncs-hidden','')} u-align-center u-heading-font u-subtitle u-text u-text-2" style="">Can you please confirm title reciept?</h2><br/>
                            <a href="#" class=" {!IF(isConfirmed,'ncs-hidden','')} u-border-none u-btn u-btn-submit u-button-style u-custom-color-1 u-btn-1">Click Here to Confirm Reciept</a><br/>
                            
                            
                            <h2 class="u-align-center u-heading-font u-subtitle u-text u-text-2 {!IF(isConfirmed, '','ncs-hidden')}">Thank you for your update.</h2>
                            </div>
                        <div class="u-form u-form-1  {!IF(isConfirmed, '','ncs-hidden')}" style="margin-top:50px;">
                              <div class="u-form-group u-form-message">
                                <label for="message-dad1" class="u-label">Would you like to send us a note?</label>
                                <textarea placeholder="Enter your message" rows="4" cols="50" id="message-dad1" name="message" class="u-border-1 u-border-grey-30 u-input u-input-rectangle u-white" required=""></textarea>
                              </div>
                              <div class="u-align-center u-form-group u-form-submit">
                                <a href="#" class="u-border-none u-btn u-btn-submit u-button-style u-custom-color-1 u-btn-1">Send Message</a>
                                <input value="submit" class="u-form-control-hidden"/>
                              </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </body>
    </html>
</apex:page>