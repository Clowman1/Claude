<apex:page standardcontroller="smagicworkflow__WorkflowXMLMap__c" extensions="smagicworkflow.WorkflowAndTaskConfiguration" action="{!registerUserForAddon}" title="{!$Label.smagicworkflow__vf_newconfig_workflow}">

<apex:stylesheet value="{!$Resource.smagicworkflow__WorkflowCSS}"/>
   
<apex:includeScript value="{!URLFOR($Resource.smagicworkflow__WorkflowJS)}"/>

<apex:includeScript value="{!URLFOR($Resource.smagicinteract__jquery)}"/>
        
  <apex:form id="confForm">
  <apex:pageMessages id="pageMessageSection"/>        
    <apex:outputpanel rendered="{!hasSecurityAccess}">
     
    <apex:pageBlock id="objDropDown">

   		<apex:pageBlockSection title="{!$Label.smagicworkflow__vf_workflow_info}">
    		<apex:inputField value="{!workflowConfig.smagicworkflow__Short_Name__c}" label="{!$Label.smagicworkflow__vf_wf_name}"/>
	 		<apex:inputField value="{!workflowConfig.smagicworkflow__Description__c}" label="{!$Label.smagicworkflow__vf_wf_desc}"/>
	 	</apex:pageBlockSection>

        <apex:pageBlockSection id="xmlGeneraterSection" title="{!$Label.smagicworkflow__vf_create_new_config}" onClick="collapseSection('xmlGeneraterDiv');" />
        <div id="xmlGeneraterDiv" style="display:block;">
        <table>
        <tr>
            <apex:actionRegion >
            <td class="labelCol" style="width:115px;" title="{!$Label.smagicworkflow__vf_workflow_set_action}">
                {!$Label.smagicworkflow__vf_lookup_object}
            </td>
            <td class="labelCol">
                :
            </td>
            <td>
                <apex:selectList id="allObjectDropDown" value="{!selectedObjName}" onchange="showPanel();" size="1">
                <apex:selectOption itemValue="" itemLabel="{!$Label.smagicworkflow__msg_select}"/>
               <apex:selectOptions value="{!lookupObjects}" />
                </apex:selectList>
            </td>
            </apex:actionRegion>
            <apex:actionFunction name="showPanel" action="{!showPanelUI}" rerender="mainPanel" />
        </tr>
        </table>
        <br/>
        <apex:outputPanel id="mainPanel">
        <apex:outputPanel id="objectPanel" rendered="{!showObjectPanel}">
        <table>
        <tr>
            <apex:actionRegion >
            <td class="labelCol" style="width:115px;" title="{!$Label.smagicworkflow__vf_recipient_msg_trigger}">
                {!$Label.smagicworkflow__vf_recipient_type}
            </td>
            <td class="labelCol">
                :
            </td>
            <td>
               <apex:selectList id="searchFieldDropDown" value="{!searchFieldName}" title="{!$Label.smagicworkflow__vf_config}" size="1" style="width:130px;">
                <apex:actionSupport event="onchange" action="{!updateLists}" rerender="availableRecipient"/>
                <apex:selectOption itemValue="" itemLabel="{!$Label.smagicworkflow__msg_select}"/>
                <apex:selectOptions value="{!searchFields}" />
                </apex:selectList>
            </td>
            </apex:actionRegion>
        </tr>
        </table>
        <br/>

        <table>
                <tr>
                    <td class="labelCol" style="width:115px;" title="{!$Label.VF_MOBILENUMBER_USERTYPE}">{!$Label.VF_AVAILABLE_RECIPIENT}</td>
                    <td>&nbsp;</td>
                    <td class="labelCol" style="width:115px;" title="{!$Label.VF_SELECTED_RECIPIENTS_SMS}">{!$Label.VF_SELECTED_RECIPIENT}</td>
                </tr>
                <tr>
                    <td style="width:200px;">
                        <apex:selectList id="availableRecipient" multiselect="false" size="6" style="width:100%;">
                            <apex:actionSupport event="onchange" action="{!updateLists}" rerender="availableRecipient"/>
                              <apex:selectOptions value="{!availableRecipient}" />  
                        </apex:selectList>
                    </td>
                     <td>
                        <br />  
                        <apex:outputLink value="#" id="leftLink" disabled="{!disableButton}"  onclick="addToList('{!$Component.availableRecipient}','{!$Component.selectedRecipient}','1', 'sObject','{!$Component.confForm.objDropDown.fieldList}', '{!$Component.confForm.objDropDown.mobileFieldList}','{!$Component.confForm.objDropDown.searchFieldDropDown}','{!$Component.confForm.recipientSection.availableRecipient}','{!$Component.confForm.objDropDown.campaignRelatedUserList}', '{!$Component.confForm.objDropDown.selectedUserGroupList}');"  styleClass="buttonCls"> {!leftToRight} </apex:outputLink><br/> <br/>
                        <apex:outputLink value="#" id="rightLink" disabled="{!disableButton}"  onclick="addToList('{!$Component.selectedRecipient}','{!$Component.availableRecipient}','2', 'sObject','{!$Component.confForm.objDropDown.fieldList}', '{!$Component.confForm.objDropDown.mobileFieldList}','{!$Component.confForm.objDropDown.searchFieldDropDown}','{!$Component.confForm.recipientSection.availableRecipient}','{!$Component.confForm.objDropDown.campaignRelatedUserList}', '{!$Component.confForm.objDropDown.selectedUserGroupList}');" styleClass="buttonCls"> {!rightToLeft} </apex:outputLink>
                       
                    </td>
                   
                    <td style="width:200px;">
                        <apex:selectList id="selectedRecipient" multiselect="false" size="6" style="width:100%;">
                          <apex:selectOptions value="{!selectedRecipient}" />  
                        </apex:selectList>
                    </td>
                   
                </tr>
        </table>
        <br/>

        <table>
            <tr>
                <td class="labelCol" style="width:115px;" title="{!$Label.smagicworkflow__vf_name_recipient_in_history}">
                    {!$Label.smagicworkflow__vf_name}
                </td>
                <td class="labelCol">
                    :
                </td>
                <td>
                  <apex:selectList id="nameDropDown" size="1"  value="{!selectedNameField}" style="width:130px;">
                        <apex:selectOptions value="{!nameFieldList}" />  
                  </apex:selectList>
                </td>
            </tr>
        </table>
        <br/>
        <table>
            <tr>
                <td class="labelCol" style="width:115px;" title="{!$Label.smagicworkflow__vf_recipient_recieves_sms}">
                    {!$Label.smagicworkflow__vf_senderid}
                </td>
                <td class="labelCol">
                    :
                </td>
                <td>
                  <apex:selectList id="senderIdDropDown" size="1" value="{!selectedSenderId}" style="width:130px;">
                        <apex:selectOptions value="{!senderIdList}" />  
                  </apex:selectList>
                </td>
            </tr>
        </table>
            <br/>
        <table>
            <tr>
                <td class="labelCol" style="width:115px;" title="{!$Label.smagicworkflow__vf_txtmsg_sms}">
                    {!$Label.smagicworkflow__vf_template}
                </td>
                <td class="labelCol">
                    :
                </td>
                <td>
                  <apex:selectList id="templateListDropDown" value="{!templateFieldName}" size="1" style="width:130px;">
                        <apex:selectOption itemValue="" itemLabel="{!$Label.smagicworkflow__msg_select}"/>
                        <apex:selectOptions value="{!templateNamesList}" />  
                  </apex:selectList>
                </td>
            </tr>
        </table>
        <br/>
        </apex:outputPanel>
       
        <apex:outputPanel id="campaignPanel" rendered="{!showCampaignPanel}">
              <apex:selectRadio value="{!smsTo}" layout="pageDirection">
                    <apex:actionSupport event="onchange" action="{!renderCampaignUI}" />    
                    <apex:selectOption itemValue="campaignMembers" itemLabel="{!$Label.smagicworkflow__vf_sendsms_campaign_members}"/>
                    <apex:selectOption itemValue="relatedUsersOfCampaign" itemLabel="{!$Label.smagicworkflow__vf_sendsms_relateduser_campaign}"/>
              </apex:selectRadio><p/>
             
              <apex:outputPanel id="campaignMembersPanel" rendered="{!showCampaignMembersPanel}">
                <table>
                    <tr>
                        <td class="labelCol">
                            {!$Label.smagicworkflow__vf_select_template_leads}
                        </td>
                        <td class="labelCol">
                            :
                        </td>
                        <td>
                            <apex:selectList id="leadTemplateDropDown" value="{!leadTemplateText}" size="1" style="width:130px;">
                                <apex:selectOption itemValue="" itemLabel="{!$Label.smagicworkflow__vf_choose_template}"/>
                                <apex:selectOptions value="{!leadTemplateDropDown}" />  
                          </apex:selectList>
                        </td>
                    </tr>
                    <tr>
                        <td class="labelCol">
                            {!$Label.smagicworkflow__vf_select_mobilefield_leads}
                        </td>
                   
                        <td class="labelCol">
                            :
                        </td>
                        <td>
                            <apex:selectList id="leadMobileDropDown" value="{!leadMobileField}" size="1" style="width:130px;">
                                <apex:selectOption itemValue="" itemLabel="{!$Label.smagicworkflow__vf_choose_field}"/>
                                <apex:selectOptions value="{!leadMobileFields}" />  
                          </apex:selectList>
                        </td>
                    </tr>
                    <tr>
                        <td class="labelCol">
                            {!$Label.smagicworkflow__vf_select_template_contact}
                        </td>
                        <td class="labelCol">
                            :
                        </td>
                        <td>
                            <apex:selectList id="contactTemplateDropDown" value="{!contactTemplateText}" size="1" style="width:130px;">
                                <apex:selectOption itemValue="" itemLabel="{!$Label.smagicworkflow__vf_choose_template}"/>
                                <apex:selectOptions value="{!contactTemplateDropDown}" />  
                          </apex:selectList>
                        </td>
                    </tr> 
                    <tr>
                        <td class="labelCol">
                           {!$Label.smagicworkflow__vf_select_mobilefield_contacts}
                        </td>
                        <td class="labelCol">
                            :
                        </td>
                        <td>
                            <apex:selectList id="contactMobileDropDown" value="{!contactMobileField}" size="1" style="width:130px;">
                                <apex:selectOption itemValue="" itemLabel="{!$Label.smagicworkflow__vf_choose_field}"/>
                                <apex:selectOptions value="{!contactMobileFields}" />  
                          </apex:selectList>
                        </td>
                    </tr>
                     <tr>
                            <td class="labelCol" style="width:130px;">
                                {!$Label.smagicworkflow__vf_senderid}
                            </td>
                            <td class="labelCol">
                                :
                            </td>
                            <td>
                              <apex:selectList id="senderIdDropDown1" size="1" value="{!selectedSenderId}" style="width:130px;">
                                    <apex:selectOptions value="{!senderIdList}" />  
                              </apex:selectList>
                            </td>
                        </tr>
                </table>
                <br/><br/>
              
              </apex:outputPanel>
             
              <apex:outputPanel id="campaignsRelatedUsersPanel" rendered="{!showCampaignsRelatedUsersPanel}">
                               
                      <table>
                            <tr>
                                <td class="labelCol">{!$Label.VF_AVAILABLE_RECIPIENT}</td>
                                <td>&nbsp;</td>
                                <td class="labelCol">{!$Label.VF_SELECTED_RECIPIENT}</td>
                            </tr>
                            <tr>
                                <td>
                                    <apex:selectList id="availableRecipientForCampaign" multiselect="false" size="6" style="width:100%;">
                                        <apex:selectOptions value="{!availableRecipientForCampaign}" />  
                                    </apex:selectList>
                                </td>
                                <td>
                                    <br /><br />  
                                    <apex:outputLink value="#" id="leftLinkForCampaign" disabled="{!disableButton}"  onclick="addToList('{!$Component.availableRecipientForCampaign}','{!$Component.selectedRecipientForCampaign}','1', 'Campaign','{!$Component.confForm.objDropDown.fieldList}', '{!$Component.confForm.objDropDown.mobileFieldList}','{!$Component.confForm.objDropDown.searchFieldDropDown}','{!$Component.confForm.recipientSection.availableRecipient}','{!$Component.confForm.objDropDown.campaignRelatedUserList}', '{!$Component.confForm.objDropDown.selectedUserGroupList}');"  styleClass="buttonCls"> {!leftToRight} </apex:outputLink><br/> <br/>
                                    <apex:outputLink value="#" id="rightLinkForCampaign"  disabled="{!disableButton}" onclick="addToList('{!$Component.selectedRecipientForCampaign}','{!$Component.availableRecipientForCampaign}','2', 'Campaign','{!$Component.confForm.objDropDown.fieldList}', '{!$Component.confForm.objDropDown.mobileFieldList}','{!$Component.confForm.objDropDown.searchFieldDropDown}','{!$Component.confForm.recipientSection.availableRecipient}','{!$Component.confForm.objDropDown.campaignRelatedUserList}', '{!$Component.confForm.objDropDown.selectedUserGroupList}');" styleClass="buttonCls"> {!rightToLeft} </apex:outputLink>
                                </td>
                                <td>
                                    <apex:selectList id="selectedRecipientForCampaign" multiselect="false" size="6" style="width:100%;">
                                        <apex:selectOptions value="{!selectedRecipientForCampaign}" />  
                                    </apex:selectList>
                                </td>
                            </tr>
                      </table>
                      <br/>
                      
                      <table>
                        <tr>
                            <td class="labelCol" style="width:115px;">
                                {!$Label.smagicworkflow__vf_senderid}
                            </td>
                            <td class="labelCol">
                                :
                            </td>
                            <td>
                              <apex:selectList id="senderIdDropDown2" size="1" value="{!selectedSenderId}" style="width:130px;">
                                    <apex:selectOptions value="{!senderIdList}" />  
                              </apex:selectList>
                            </td>
                        </tr>
                    </table>
                      <table>
                      <tr>
                          <td class="labelCol" style="width:115px;">
                            {!$Label.smagicworkflow__vf_template_name}
                          </td>
                          <td class="labelCol">
                            :
                          </td>
                          <td>
                            <apex:selectList id="campaignTemplateListDropDown" value="{!campaignUserTemplate}" size="1" style="width:130px;">
                                <apex:selectOption itemValue="" itemLabel="{!$Label.smagicworkflow__vf_choose_template}"/>
                                <apex:selectOptions value="{!campaignUserTemplateNamesList}" />  
                            </apex:selectList>
                          </td>
                      </tr>
                      </table>
                       <br/>
                     
              </apex:outputPanel>
          </apex:outputPanel>
        </apex:outputPanel>
       
        <apex:inputHidden value="{!selectedFieldValue}" id="fieldList" />
        <apex:inputHidden value="{!selectedMobileFieldsValue}" id="mobileFieldList" />
        <apex:inputHidden value="{!campaignRelatedUserFieldValue}" id="campaignRelatedUserList" />
        <apex:inputHidden value="{!selectedUserGroupValue}" id="selectedUserGroupList" />
       
         <apex:commandButton value="{!$Label.smagicworkflow__vf_reset}" title="{!$Label.smagicworkflow__vf_reset}" action="{!reset}" style="margin-left:30%;margin-top:5px;" onclick="clearList('{!$Component.confForm.objDropDown.allObjectDropDown}','{!$Component.confForm.objDropDown.selectedRecipientForCampaign}','{!$Component.confForm.objDropDown.selectedRecipient}');"/>&#160;&#160;&#160;&#160;&#160;
         <apex:commandButton value="{!$Label.smagicworkflow__vf_create}" title="{!$Label.smagicworkflow__vf_create_config}" action="{!generate}" disabled="{!disableButton}" style="margin-top:5px;"  reRender="{!$Component.confForm.ConfigurationSection.configPanel.configNameNotificationMessage.configUrl}" onclick="clearList('{!$Component.confForm.objDropDown.allObjectDropDown}','{!$Component.confForm.objDropDown.selectedRecipientForCampaign}','{!$Component.confForm.objDropDown.selectedRecipient}');"/>&#160;&#160;&#160;&#160;&#160;
          <apex:commandButton value="{!$Label.smagicworkflow__vf_cancel}" title="{!$Label.smagicworkflow__vf_cancel_config}" action="{!cancel}"/>
         </div>
        <apex:pageBlockSection id="ConfigurationSection" title="{!$Label.smagicworkflow__vf_copy_config_name}" onclick="collapseSection('configNameSection');" />
       <div id="configNameSection" style="display:block;">
         <apex:outputPanel id="configPanel">
            <table>
                <tr>
                    <td class="labelCol">
                        {!$Label.smagicworkflow__vf_config_name}
                    </td>
                    <td class="labelCol">
                        :
                    </td>
                    <td>
                        <apex:outputLabel value="{!xmlName}" id="xmlName" style="font-weight:bold;"/>&nbsp;&nbsp;&nbsp;&nbsp;
                         <apex:outputLink id="configUrl" value="{!configUrl}" target="_blank" rendered="{!hideConfigLink}">{!$Label.smagicworkflow__vf_view_config}</apex:outputLink>
                    </td>
                  <!--  <td>
                        <input type="button" id ="copy-button" value ="Copy To Clipboard" onClick="copyText();"/>
                    </td>
                   -->
                    
                </tr>
            </table>
            
              <br/>
              <apex:outputPanel id="configNameNotificationMessage" style="width: 165px; color:green;margin-left:13px; ">
              </apex:outputPanel>
          </apex:outputPanel>
          </div>
 
         <apex:pageBlockSection id="RuleSection" title="{!$Label.smagicworkflow__vf_create_workflow_task_msg}" onclick="collapseSection('ruleSection');" />
   
        <div id="ruleSection" style="display:block;">
        <table>
            <tr>
                <td>{!$Label.WORKFLOW_STEPS1}&nbsp; <apex:outputLink id="workflowUrl" target="_blank" value="{!workflowUrl}">{!$Label.smagicworkflow__link_click_here}</apex:outputLink></td>
            </tr>
            <tr>
                <td>{!$Label.WORKFLOW_STEPS2}</td>
            </tr>
            <tr>
                <td>{!$Label.WORKFLOW_STEPS3}</td>
            </tr>
            <tr>
                <td>&#160;&#160;&#160;&#160;&#160;{!$Label.WORKFLOW_STEPS4}</td>
            </tr>
            <tr>
                <td>&#160;&#160;&#160;&#160;&#160;{!$Label.WORKFLOW_STEPS5}</td>
            </tr>
            <tr>
                <td>{!$Label.WORKFLOW_STEPS6}</td>
            </tr>
        </table>
         </div>
    </apex:pageBlock>
    </apex:outputpanel>
    </apex:form>

</apex:page>