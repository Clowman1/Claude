<apex:page standardController="Campaign" extensions="TwilioSF.LightningOutController" lightningStylesheets="true" sidebar="false">
<html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <apex:includeLightning />
    <apex:stylesheet value="{!URLFOR($Resource.TwilioSF__VFtoast, '/vftoast/css/vfToast.css')}" />

    <style>
        .slds-scope .slds-page-header {
            background: #F4F6F9;
            border-bottom: 1px solid #CCCCCC;
        }

        .slds-scope .slds-card {
            border: none;
        }

        .slds-scope .slds-page-header__title {
            font-weight: 300;
            font-size: 1.5rem;
            margin: 0 0 0.5rem 0; 
        }

        .slds-scope .back-btn {
            margin-top: -10px;
            margin-bottom: 10px;
        }

        .slds-scope .back-btn .slds-icon {
            height: 10px;
            width: 10px;
            fill: rgb(0, 112, 210);
        }
    </style>
    <body>
        <div class="slds-scope">
         <apex:form >
            <div id="slds-notify_container" class="slds-notify_container"></div>
            <div class="slds-page-header">
                <button class="float-left slds-button back-btn" onclick="navigateToRecordId();return false;">
                    <span class="slds-icon_container slds-icon-standard-utility" title="back">
                        <svg aria-hidden="true" class="slds-icon">
                            <use xlink:href="{!URLFOR($Asset.SLDS, 'assets/icons/utility-sprite/svg/symbols.svg#back')}"></use>
                        </svg>
                        <span class="slds-assistive-text">Back to Campaign</span>
                    </span>
                    Back to Campaign
                </button>
                <div class="slds-media">
                    <div class="slds-media__figure">
                                <span class="slds-avatar slds-avatar_large">
                                    <img class="twilio-icon" src="{!$Resource.TwilioIconSVG}"/>
                                </span>
                    </div>
                    <div class="slds-media__body">
                        <h1 class="slds-page-header__title slds-truncate slds-align-middle" title="Twilio Configuration">Twilio Bulk Campaign SMS Message</h1>
                        <p class="slds-text-body_small slds-line-height_reset">Sends SMS message to all campaign members with a mobile number</p>
                    </div>
                </div>
            </div>
        <apex:actionFunction name="navigateToRecordId" action="{!navigateToRecordId}"/>
        </apex:form>
            <div id="bulkMessageBuilder" />

        </div>
        <script>
            var myUserContext = "{!$User.UITheme}";
            var bulkMessageRelatedListId = '{!JSENCODE(HTMLENCODE(bulkMessageRelatedListId))}';
            var recordId = '{!JSENCODE(HTMLENCODE(recordId))}';
            var reportId = '{!JSENCODE(HTMLENCODE(reportId))}';
            if(bulkMessageRelatedListId != null &&  bulkMessageRelatedListId != undefined && bulkMessageRelatedListId != ''){
                if(bulkMessageRelatedListId.length > 15){
                    bulkMessageRelatedListId = bulkMessageRelatedListId.substring(0,15);
                }
            }

            var objIdPrefix = '{!JSENCODE(HTMLENCODE(objIdPrefix))}';
            var bulkMessageIdPrefix = '{!JSENCODE(HTMLENCODE(bulkMessageIdPrefix))}';

            $Lightning.use("{!JSENCODE(namespace)}:BulkMessage", function() {
                $Lightning.createComponent(
                    "{!JSENCODE(namespace)}:BulkMessageBuilder",
                    {   recordId: '{!JSENCODE(HTMLENCODE(recordId))}',
                        sObjectType: '{!JSENCODE(HTMLENCODE(sobjectType))}',
                    },
                    "bulkMessageBuilder",
                    function(cmp) {
                        $A.eventService.addHandler({
                            event: 'force:navigateToSObject',
                            handler: function(event) {
                                if (myUserContext == 'Theme4t' || myUserContext == 'Theme4d' || myUserContext == 'Theme4u'){
                                    // The Visualforce page is in S1 or Lightning Experience
                                    sforce.one.navigateToSObject(event.getParams().recordId);
                                } else if (myUserContext == 'Theme3') {
                                    // The Visualforce page is  running in Classic
                                    window.parent.location = '/' + event.getParams().recordId;
                                } else {
                                    console.log("Unsupported theme");
                                }
                            }
                        });
                        $A.eventService.addHandler({
                            event: 'force:navigateToRelatedList',
                            handler: function(event) {
                                if (myUserContext == 'Theme4t' || myUserContext == 'Theme4d' || myUserContext == 'Theme4u'){
                                    // The Visualforce page is in S1 or Lightning Experience
                                    var params = event.getParams();
                                    sforce.one.navigateToRelatedList(event.getParams().relatedListId,event.getParams().parentRecordId);
                                } else if (myUserContext == 'Theme3') {
                                    // The Visualforce page is  running in Classic
                                    var url = '/'+bulkMessageIdPrefix+'?rlid='+bulkMessageRelatedListId+'&id='+event.getParams().parentRecordId.substring(0,15);
                                    window.location.assign(url);
                                } else {
                                    console.log("Unsupported theme");
                                }
                            }
                        });
                        $A.eventService.addHandler({
                            event: 'force:navigateToURL',
                            handler: function(event) {
                                if (myUserContext == 'Theme4t' || myUserContext == 'Theme4d' || myUserContext == 'Theme4u'){
                                    // The Visualforce page is in S1 or Lightning Experience
                                    var params = event.getParams();
                                    if(reportId == '' && params.url.includes("Report")) {
                                        console.log("missing access to report");
                                        Toaster.create({
                                            title: "Access Error",
                                            message: "You do not have access to that Report.",
                                            type: "error",
                                            mode: "dismissable",
                                            duration: "5000"
                                        });                                        
                                    }
                                    else {
                                        sforce.one.navigateToURL(event.getParams().url);
                                    }
                                } else if (myUserContext == 'Theme3') {
                                    // The Visualforce page is running in Classic
                                    if(reportId != '') {
                                        var url = '/'+reportId+'?pv0='+recordId.substring(0,15);
                                        window.location.assign(url);
                                    }
                                    else {
                                        console.log("missing access to report");
                                        Toaster.create({
                                            title: "Access Error",
                                            message: "You do not have access to that Report.",
                                            type: "error",
                                            mode: "dismissable",
                                            duration: "5000"
                                        });                                        
                                    }
                                } else {
                                    console.log("Unsupported theme");
                                }
                            }
                        });
                    }
                );
            });
        </script>
    <apex:includeScript value="{!URLFOR($Resource.TwilioSF__VFtoast, '/vftoast/js/lib/vfToast.js')}" />
    </body>
</html>
</apex:page>