<apex:page renderAs="pdf" applyHtmlTag="false" standardController="Transaction__c" showHeader="false">
    <html>
    <head>
        <style>
            table table td{
                padding-bottom: 10px;
            }
            body {
                font-family: Arial, Helvetica, sans-serif;
            }

            @page {
                size: portrait; /*landscape orientation*/
                /*page numbers in the bottom center of each page in the pdf document*/
                @bottom-left {
                    content: "";
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 80%;
                    bottom:10px;
                }
                /*placeholders for other content areas*/

                @top-left {
                    content: element(top-left);
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 80%;
                }

            }
        </style>
    </head>
    <body>
    <img style="position:fixed; top:10px; left:15px; height:auto; width:125px;" src="{!$Resource.Reach_Logo}"/>

    <div align="right"><strong>Generated By</strong>: {!$User.FirstName} {!$User.LastName}</div>
    <div align="right">
        <strong>Date</strong>: {!DAY(Today())} {!CASE(MONTH(Today()), 1, 'January', 2, 'February', 3, 'March', 4, 'April', 5, 'May', 6, 'June', 7, 'July', 8, 'August', 9, 'September', 10, 'October', 11, 'November', 12, 'December', 'Unknown')} {!YEAR(Today())}
    </div>

    <div align="center" style="margin-top:50px;">
        <h3>Wire Order</h3>
    </div>

    <table align="center" style="width:100%; border: 1px solid #001b54; margin:50px 0 25px 0;">
        <tr style="width:100%;">
            <td style=" background-color: #001b54; color: #FFFFFF; font-size: 160%; width:1.5in; padding:10px 0; text-align:center;">Details</td>
            <td style="font-size:70%">
                <table style="width:50%;float:left;">
                    <tr>
                        <td style="width:40%;">Borrower Name:</td>
                        <td><apex:outputField value="{!Transaction__c.Borrower_Name__c}"/></td>
                    </tr>
                    <tr>
                        <td>Property Address:</td>
                        <td>{!Transaction__c.Property_Address__c} {!Transaction__c.Property_City__c}, {!Transaction__c.Property_State__c} {!Transaction__c.Property_Postal_Code__c}</td>
                    </tr>
                    <tr>
                        <td>MERS Min #:</td>
                        <td><apex:outputField value="{!Transaction__c.MERS_Min__c}"/></td>
                    </tr>
                    <tr>
                        <td>Loan Number:</td>
                        <td><apex:outputField value="{!Transaction__c.Loan_Number__c}"/></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                    </tr>

                    <tr>
                        <td>Origination Fee:</td>
                        <td><apex:outputField value="{!Transaction__c.Origination_Charges__c}"/></td>
                    </tr>
                    <tr>
                        <td>Warehouse Fee:</td>
                        <td><apex:outputField value="{!Transaction__c.Warehouse_Fee__c}"/></td>
                    </tr>
                    <tr>
                        <td>Credit Report Fee:</td>
                        <td><apex:outputField value="{!Transaction__c.Credit_Report_Fee__c}"/></td>
                    </tr>
                    <tr>
                        <td>MERS Fee:</td>
                        <td><apex:outputField value="{!Transaction__c.MERS_Fee__c}"/></td>
                    </tr>
                    <tr>
                        <td>Flood Cert: </td>
                        <td><apex:outputField value="{!Transaction__c.Flood_Cert__c}"/></td>
                    </tr>
                    <tr>
                        <td>Appraisal Cost:</td>
                        <td><apex:outputField value="{!Transaction__c.Appraisal_Cost__c}"/></td>
                    </tr>
                    <tr>
                        <td>Tax Service Fee:</td>
                        <td><apex:outputField value="{!Transaction__c.Tax_Service_Fee__c}"/></td>
                    </tr>
                    <tr>
                        <td>VA/FHA Funding Fee</td>
                        <td><apex:outputField value="{!Transaction__c.VA_FHA_Funding_Fee__c}"/></td>
                    </tr>
                    <tr>
                        <td>Lender Credit:</td>
                        <td><apex:outputField value="{!Transaction__c.Lender_Credit__c}"/></td>
                    </tr>
                    <tr>
                        <td>Escrow Total:</td>
                        <td><apex:outputField value="{!Transaction__c.Escrow_Total__c}"/></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                    </tr>
                </table>
                <table style="width:50%; float:left;">
                    <tr>
                        <td style="width:40%;">Closing Date:</td>
                        <td><apex:outputField value="{!Transaction__c.Closing_Date__c}"/></td>
                    </tr>
                    <tr>
                        <td>Disbursement Date</td>
                        <td><apex:outputField value="{!Transaction__c.Settlement_Time_for_Wire__c}"/></td>
                    </tr>
                    <tr>
                        <td>Loan Amount:</td>
                        <td><apex:outputField value="{!Transaction__c.Loan_Amount__c}"/></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>To Be Funded:</td>
                        <td><apex:outputField value="{!Transaction__c.Amount_To_Be_Funded__c}"/></td>
                    </tr>
                    <tr>
                        <td>Haircut:</td>
                        <td><apex:outputField value="{!Transaction__c.Haircut__c}"/></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Interest Rate:</td>
                        <td><apex:outputField value="{!Transaction__c.Interest_Rate__c}"/></td>
                    </tr>
                    <tr>
                        <td>PPD Interest Type:</td>
                        <td><apex:outputField value="{!Transaction__c.PPD_Interest_Type__c}"/></td>
                    </tr>
                    <tr>
                        <td>PPD Interest:</td>
                        <td><apex:outputField value="{!Transaction__c.PPD_Interest__c}"/></td>
                    </tr>

                    <tr>
                        <td></td>
                        <td></td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    <table align="center" style="width:100%; border: 1px solid #001b54; margin-bottom:0px;" >
        <tr style="width:100%;">
            <td style="width:1.5in; background-color: #001b54; color: #FFFFFF; font-size: 15px; padding:10px 0; text-align:center;">FUNDING AUTHORIZATION REQUIRED</td>
            <td>
                WIRE MAY NOT BE DISBURSED UNTIL ALL FUNDING DOCS HAVE BEEN EMAILED AND
                REACH HOME LOANS ISSUES FUNDING APPROVAL<br/><br/>
                Email all docs to <a>POSTCLOSING@REACHHOMELOANS.COM</a><br/><br/>
                <ol>
                    <li>Signed Closing Package</li>
                    <li>Signed Seller CD (Purchase Only)</li>
                    <li>Copy of Title Alta/HUD</li>
                </ol>
            </td>
        </tr>
    </table>
    <div style="position:fixed; bottom:0px;">
        <p><b>Return Wires</b> IF FOR ANY REASON THIS LOAN DOES NOT CLOSE WITHIN 24 HOURS OF
            RECEIPT OF FUNDS, IMMEDIATELY NOTIFY REACH HOME LOANS, INC TO RETURN
            ALL DOCUMENTS AND FOR RETURN WIRE INSTRUCTIONS</p>
    </div>
    </body>
    </html>


</apex:page>