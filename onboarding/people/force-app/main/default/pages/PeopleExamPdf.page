<apex:page controller="PeopleExamPdfController" renderAs="pdf" applyHtmlTag="false" applyBodyTag="false" showHeader="false" sidebar="false" standardStylesheets="false">
<html>
<head>
<style>
    @page { size: letter; margin: 0.6in; @bottom-right { content: "Page " counter(page) " of " counter(pages); font-size: 8pt; color: #555; } }
    body { font-family: Arial, sans-serif; font-size: 10pt; color: #111; }
    h1 { font-size: 15pt; margin: 0 0 4px; }
    .sub { color: #555; font-size: 9pt; margin-bottom: 14px; }
    table { width: 100%; border-collapse: collapse; }
    .info td { padding: 4px 6px; border: 1px solid #bbb; }
    .info .k { width: 22%; background: #f2f2f2; font-weight: bold; }
    h2 { font-size: 11pt; margin: 16px 0 4px; }
    .items th { text-align: left; background: #e8e8e8; border: 1px solid #bbb; padding: 4px 6px; font-size: 9pt; }
    .items td { border: 1px solid #bbb; padding: 4px 6px; font-size: 9pt; }
    .sign { margin-top: 22px; border: 1px solid #888; padding: 10px 12px; }
    .draft { color: #92400e; font-weight: bold; }
</style>
</head>
<body>
    <h1>Reach Home Loans: New Hire Onboarding and Training Checklist</h1>
    <div class="sub">NMLS# 2266637 · Printed {!printedAt}</div>

    <table class="info">
        <tr><td class="k">Employee</td><td>{!employee.Name}</td><td class="k">NMLS ID</td><td>{!employee.NMLS_ID__c}</td></tr>
        <tr><td class="k">Title / Role</td><td>{!employee.Role__c}</td><td class="k">Start date</td><td><apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!employee.Start_Date__c}"/></apex:outputText></td></tr>
        <tr><td class="k">Manager</td><td>{!employee.Manager__r.Name}</td><td class="k">Branch</td><td>{!employee.Branch__r.Name}</td></tr>
        <tr><td class="k">Licensed states</td><td colspan="3">{!SUBSTITUTE(employee.Licensed_States__c, ';', ', ')}</td></tr>
    </table>

    <apex:repeat value="{!sections}" var="s">
        <h2>{!s.name}</h2>
        <table class="items">
            <tr><th style="width:52%">Item</th><th style="width:12%">Status</th><th style="width:24%">Completed by</th><th style="width:12%">Date</th></tr>
            <apex:repeat value="{!s.rows}" var="r">
                <tr><td>{!r.item}</td><td>{!r.status}</td><td>{!r.completedBy}</td><td>{!r.completedAt}</td></tr>
            </apex:repeat>
        </table>
    </apex:repeat>

    <div class="sign">
        <apex:outputPanel rendered="{!checklist.Status__c == 'Signed Off'}">
            <strong>Compliance sign-off</strong><br/>
            {!attestation}<br/><br/>
            Signed off by: <strong>{!checklist.Signed_Off_By__r.Name}</strong> &nbsp;·&nbsp; {!signedAt}
        </apex:outputPanel>
        <apex:outputPanel rendered="{!checklist.Status__c != 'Signed Off'}">
            <span class="draft">DRAFT: not yet signed off.</span>
        </apex:outputPanel>
    </div>
</body>
</html>
</apex:page>
