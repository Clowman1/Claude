<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>BD Command Center</masterLabel>
    <description>Business development home: partners, touches, invites. Mode "overview" is the read-only manager view.</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage">
            <property name="mode" type="String" label="Mode" datasource="home,overview" default="home"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
