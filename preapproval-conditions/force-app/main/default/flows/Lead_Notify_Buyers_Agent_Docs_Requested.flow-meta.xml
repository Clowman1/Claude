        <defaultConnectorLabel>No Mobile Number</defaultConnectorLabel>
        <rules>
            <name>Agent_Mobile_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Realtor_Buying_Agent__r.PersonMobilePhone</leftValueReference>
