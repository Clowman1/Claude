    <description>Texts the buyer&apos;s agent once, the first time pre-approval documents are requested. Fires off Initial_Docs_Requested_Date__c, which the Pre-Approval Docs Needed email stamps exactly once, so it cannot repeat on a resend. Uses the same TwilioSF__TwilioSendSMS action as the Log A Call buyer-agent message.</description>
    <environments>Default</environments>
    <formulas>
        <name>MessageBody</name>
        <dataType>String</dataType>
        <expression>&quot;Documents have been requested from &quot; &amp; TRIM(BLANKVALUE({!$Record.FirstName}, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE({!$Record.LastName}, &quot;&quot;)) &amp; &quot; to complete the Pre-Approval&quot;</expression>
    </formulas>
    <interviewLabel>Lead: Notify Buyer&apos;s Agent Docs Requested {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead: Notify Buyer&apos;s Agent Docs Requested</label>
