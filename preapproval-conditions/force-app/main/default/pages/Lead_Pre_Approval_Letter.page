<apex:page standardController="Lead"
           extensions="LeadPreApprovalLetterPdfExtension"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="false"
           applyBodyTag="false"
           cache="false"
           renderAs="pdf">
<html>
<head>
    <style type="text/css">
        @page {
            size: letter;
            margin: 0.55in 0.6in 0.5in 0.6in;
        }
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
            color: #1b2f5c;
            margin: 0;
        }

        /* The preview draws a Unicode check; this renderer has no glyph for it in its base
           fonts, so the mark silently vanished from the PDF. ZapfDingbats is always present and
           its character 4 is a check, so the PDF shows that one and hides the other. */
        .tick-screen { display: none; }
        .tick-print { font-family: ZapfDingbats; }
    </style>
</head>
<body>
    <apex:outputText value="{!letterHtml}" escape="false"/>
</body>
</html>
</apex:page>
