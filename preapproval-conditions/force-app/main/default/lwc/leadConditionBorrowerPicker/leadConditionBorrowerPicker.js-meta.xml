<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Condition Borrower Picker</masterLabel>
    <description>Asks which borrower a set of conditions is for. Outputs ALL, PRIMARY, or a Borrower record Id.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Lead Id" role="inputOnly"/>
            <property name="assignment" type="String" label="Assignment" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
